{
  "$comment": "THE WORKER JOB CARD CONTRACT — one input, the exact text the worker's swipe card draws, in order. The reference is the worker app's Design1JobCard (apps/worker-app/lib/features/swipe/presentation/widgets/design1_job_card.dart) fed by _cardData (apps/worker-app/lib/features/swipe/presentation/swipe_jobs_screen.dart) through FeedItem.fromJson (apps/worker-app/lib/core/api/api_models.dart). `input` uses the GET /feed wire keys (`title` is job_postings.role_title). `expected` is the card's text slots top to bottom; a slot absent from the list is not drawn. `clamps` are the Text maxLines. The expected strings were written from the Dart formatters (core/util/pay_format.dart, core/util/job_display.dart), not generated by either client. Consumers: apps/payer-web/src/components/job-card-contract.test.tsx (the payer's live preview); a Dart test can pump Design1JobCard from the same file. `role_kind` (GET /feed since the owner ruling of 2026-10-05, ADR-0024 addendum) is one of the 21 declared kinds or null and keys the card's role ILLUSTRATION: it is art, never text, so a case carrying it expects exactly the slots the same input without it would — it adds no text slot.",
  "version": 1,
  "clamps": { "title": 2, "place": 1, "pay_label": 1, "pay_band": 1, "chip": 2 },
  "cases": [
    {
      "name": "typical",
      "input": {
        "title": "CNC Turner",
        "role_kind": "cnc_turner",
        "city": "Pune",
        "area": "Chakan MIDC",
        "pay_min": 18000,
        "pay_max": 26000,
        "pay_type": "in_hand",
        "min_experience_years": 2,
        "max_experience_years": 5,
        "shift": "day",
        "needed_by": "soon",
        "requirements": ["Fanuc control", "Drawing reading"],
        "benefits": ["PF + ESI", "Canteen"]
      },
      "expected": [
        { "slot": "title", "text": "CNC Turner" },
        { "slot": "place", "text": "Chakan MIDC, Pune" },
        { "slot": "pay_label", "text": "MAHINE KI SALARY" },
        { "slot": "pay_type", "text": "IN-HAND" },
        { "slot": "pay_band", "text": "₹18,000–26,000/mah" },
        { "slot": "duty_label", "text": "Duty & Suvidhayein" },
        { "slot": "chip", "kind": "shift", "text": "Day Shift" },
        { "slot": "chip", "kind": "experience", "text": "2–5 yrs experience" },
        { "slot": "chip", "kind": "needed_by", "text": "Jaldi chahiye" },
        { "slot": "chip", "kind": "requirement", "text": "Fanuc control" },
        { "slot": "chip", "kind": "requirement", "text": "Drawing reading" },
        { "slot": "chip", "kind": "benefit", "text": "PF + ESI" },
        { "slot": "chip", "kind": "benefit", "text": "Canteen" }
      ]
    },
    {
      "name": "role_kind is art, not text — it adds no slot",
      "input": { "title": "MIG Welder", "role_kind": "welder", "city": "Pune", "area": "Bhosari" },
      "expected": [
        { "slot": "title", "text": "MIG Welder" },
        { "slot": "place", "text": "Bhosari, Pune" }
      ]
    },
    {
      "name": "title and city only — no salary box, no duty section",
      "input": { "title": "Helper", "city": "Pune", "area": null },
      "expected": [
        { "slot": "title", "text": "Helper" },
        { "slot": "place", "text": "Pune" }
      ]
    },
    {
      "name": "empty area string reads as no area",
      "input": { "title": "Fitter", "city": "Nashik", "area": "" },
      "expected": [
        { "slot": "title", "text": "Fitter" },
        { "slot": "place", "text": "Nashik" }
      ]
    },
    {
      "name": "no city: the phone still draws the row — 'Area, ' beside the pin (FeedItem city defaults to '')",
      "input": { "title": "Fitter", "area": "Chakan" },
      "expected": [
        { "slot": "title", "text": "Fitter" },
        { "slot": "place", "text": "Chakan, " }
      ]
    },
    {
      "name": "no city and no area: the phone draws the pin with nothing beside it",
      "input": { "title": "Helper" },
      "expected": [
        { "slot": "title", "text": "Helper" },
        { "slot": "place", "text": "" }
      ]
    },
    {
      "name": "no title: the phone draws an empty title (FeedItem title defaults to '')",
      "input": { "city": "Pune" },
      "expected": [
        { "slot": "title", "text": "" },
        { "slot": "place", "text": "Pune" }
      ]
    },
    {
      "name": "min pay only, no pay type — no pill",
      "input": { "title": "Welder", "city": "Pune", "area": "Bhosari", "pay_min": 16000 },
      "expected": [
        { "slot": "title", "text": "Welder" },
        { "slot": "place", "text": "Bhosari, Pune" },
        { "slot": "pay_label", "text": "MAHINE KI SALARY" },
        { "slot": "pay_band", "text": "₹16,000+/mah" }
      ]
    },
    {
      "name": "max pay only",
      "input": { "title": "Welder", "city": "Pune", "pay_max": 26000, "pay_type": "gross" },
      "expected": [
        { "slot": "title", "text": "Welder" },
        { "slot": "place", "text": "Pune" },
        { "slot": "pay_label", "text": "MAHINE KI SALARY" },
        { "slot": "pay_type", "text": "GROSS" },
        { "slot": "pay_band", "text": "Up to ₹26,000/mah" }
      ]
    },
    {
      "name": "equal pay bounds read as one amount",
      "input": { "title": "Helper", "city": "Pune", "pay_min": 20000, "pay_max": 20000, "pay_type": "in_hand" },
      "expected": [
        { "slot": "title", "text": "Helper" },
        { "slot": "place", "text": "Pune" },
        { "slot": "pay_label", "text": "MAHINE KI SALARY" },
        { "slot": "pay_type", "text": "IN-HAND" },
        { "slot": "pay_band", "text": "₹20,000/mah" }
      ]
    },
    {
      "name": "lakh amounts use Indian grouping",
      "input": { "title": "Tool Room Supervisor", "city": "Chennai", "area": "Ambattur", "pay_min": 125000, "pay_max": 150000, "pay_type": "gross" },
      "expected": [
        { "slot": "title", "text": "Tool Room Supervisor" },
        { "slot": "place", "text": "Ambattur, Chennai" },
        { "slot": "pay_label", "text": "MAHINE KI SALARY" },
        { "slot": "pay_type", "text": "GROSS" },
        { "slot": "pay_band", "text": "₹1,25,000–1,50,000/mah" }
      ]
    },
    {
      "name": "crore ceiling, CTC",
      "input": { "title": "Plant Head", "city": "Pune", "pay_min": 1500000, "pay_max": 10000000, "pay_type": "ctc" },
      "expected": [
        { "slot": "title", "text": "Plant Head" },
        { "slot": "place", "text": "Pune" },
        { "slot": "pay_label", "text": "MAHINE KI SALARY" },
        { "slot": "pay_type", "text": "CTC" },
        { "slot": "pay_band", "text": "₹15,00,000–1,00,00,000/mah" }
      ]
    },
    {
      "name": "under a thousand is not grouped",
      "input": { "title": "Day Helper", "city": "Pune", "pay_min": 800 },
      "expected": [
        { "slot": "title", "text": "Day Helper" },
        { "slot": "place", "text": "Pune" },
        { "slot": "pay_label", "text": "MAHINE KI SALARY" },
        { "slot": "pay_band", "text": "₹800+/mah" }
      ]
    },
    {
      "name": "a negative bound is treated as not stated; an unknown pay type draws no pill",
      "input": { "title": "Welder", "city": "Pune", "pay_min": -5, "pay_max": 26000, "pay_type": "weekly" },
      "expected": [
        { "slot": "title", "text": "Welder" },
        { "slot": "place", "text": "Pune" },
        { "slot": "pay_label", "text": "MAHINE KI SALARY" },
        { "slot": "pay_band", "text": "Up to ₹26,000/mah" }
      ]
    },
    {
      "name": "experience windows",
      "input": { "title": "Machinist", "city": "Pune", "min_experience_years": 5 },
      "expected": [
        { "slot": "title", "text": "Machinist" },
        { "slot": "place", "text": "Pune" },
        { "slot": "duty_label", "text": "Duty & Suvidhayein" },
        { "slot": "chip", "kind": "experience", "text": "5+ yrs experience" }
      ]
    },
    {
      "name": "experience max only",
      "input": { "title": "Machinist", "city": "Pune", "max_experience_years": 5 },
      "expected": [
        { "slot": "title", "text": "Machinist" },
        { "slot": "place", "text": "Pune" },
        { "slot": "duty_label", "text": "Duty & Suvidhayein" },
        { "slot": "chip", "kind": "experience", "text": "Up to 5 yrs experience" }
      ]
    },
    {
      "name": "experience equal bounds and a zero minimum",
      "input": { "title": "Machinist", "city": "Pune", "min_experience_years": 3, "max_experience_years": 3, "shift": "night", "needed_by": "immediate" },
      "expected": [
        { "slot": "title", "text": "Machinist" },
        { "slot": "place", "text": "Pune" },
        { "slot": "duty_label", "text": "Duty & Suvidhayein" },
        { "slot": "chip", "kind": "shift", "text": "Night Shift" },
        { "slot": "chip", "kind": "experience", "text": "3 yrs experience" },
        { "slot": "chip", "kind": "needed_by", "text": "Turant chahiye" }
      ]
    },
    {
      "name": "zero-year minimum is a real bound",
      "input": { "title": "Trainee", "city": "Pune", "min_experience_years": 0, "max_experience_years": 2, "shift": "rotational", "needed_by": "flexible" },
      "expected": [
        { "slot": "title", "text": "Trainee" },
        { "slot": "place", "text": "Pune" },
        { "slot": "duty_label", "text": "Duty & Suvidhayein" },
        { "slot": "chip", "kind": "shift", "text": "Rotational Shift" },
        { "slot": "chip", "kind": "experience", "text": "0–2 yrs experience" },
        { "slot": "chip", "kind": "needed_by", "text": "Flexible" }
      ]
    },
    {
      "name": "unknown shift and needed-by values are never echoed",
      "input": { "title": "Packer", "city": "Pune", "shift": "graveyard", "needed_by": "yesterday", "benefits": ["Canteen"] },
      "expected": [
        { "slot": "title", "text": "Packer" },
        { "slot": "place", "text": "Pune" },
        { "slot": "duty_label", "text": "Duty & Suvidhayein" },
        { "slot": "chip", "kind": "benefit", "text": "Canteen" }
      ]
    },
    {
      "name": "chip text is trimmed and blank chips are dropped",
      "input": { "title": "Packer", "city": "Pune", "requirements": ["  Forklift licence  ", "", "   "], "benefits": [" PF + ESI"] },
      "expected": [
        { "slot": "title", "text": "Packer" },
        { "slot": "place", "text": "Pune" },
        { "slot": "duty_label", "text": "Duty & Suvidhayein" },
        { "slot": "chip", "kind": "requirement", "text": "Forklift licence" },
        { "slot": "chip", "kind": "benefit", "text": "PF + ESI" }
      ]
    },
    {
      "name": "long values are drawn in full (the clamps cut them visually, not the text)",
      "input": {
        "title": "Senior CNC Turner / VMC Setter-Operator cum In-process Quality Inspector — precision automotive shafts",
        "city": "Pimpri-Chinchwad (Bhosari Industrial Area)",
        "area": "Sector 10, PCNTDA Industrial Estate, near Telco Road",
        "requirements": ["Fanuc/Siemens/Mitsubishi-0i-TF-Plus-control-experience-mandatory"]
      },
      "expected": [
        { "slot": "title", "text": "Senior CNC Turner / VMC Setter-Operator cum In-process Quality Inspector — precision automotive shafts" },
        { "slot": "place", "text": "Sector 10, PCNTDA Industrial Estate, near Telco Road, Pimpri-Chinchwad (Bhosari Industrial Area)" },
        { "slot": "duty_label", "text": "Duty & Suvidhayein" },
        { "slot": "chip", "kind": "requirement", "text": "Fanuc/Siemens/Mitsubishi-0i-TF-Plus-control-experience-mandatory" }
      ]
    },
    {
      "name": "Devanagari text passes through untouched",
      "input": { "title": "सीएनसी टर्नर", "city": "पुणे", "area": "चाकण", "benefits": ["कैंटीन"] },
      "expected": [
        { "slot": "title", "text": "सीएनसी टर्नर" },
        { "slot": "place", "text": "चाकण, पुणे" },
        { "slot": "duty_label", "text": "Duty & Suvidhayein" },
        { "slot": "chip", "kind": "benefit", "text": "कैंटीन" }
      ]
    }
  ]
}
