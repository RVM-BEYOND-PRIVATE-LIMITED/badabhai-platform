{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "scripts/**/*", "vitest.config.ts"]
}
