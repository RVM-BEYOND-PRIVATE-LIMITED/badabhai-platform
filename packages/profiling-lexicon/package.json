{
  "name": "@badabhai/profiling-lexicon",
  "version": "0.1.0",
  "private": true,
  "description": "Hinglish occupational lexicon shared by the TypeScript orchestrator and the Python ai-service. Data-first: the gazetteers, detectors and value normalizers live as JSON so both languages read ONE source.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/sync-mirror.mjs --check && vitest run --passWithNoTests",
    "lexicon:sync": "node scripts/sync-mirror.mjs",
    "lexicon:verify": "node scripts/sync-mirror.mjs --check",
    "clean": "rimraf --glob dist .turbo *.tsbuildinfo"
  }
}
