{"source":"isco08","code":"2131","level":4,"parent_code":"213","isco_major":"2","isco_unit":"2131","skill_level":4,"label_en":"Biologists, Botanists, Zoologists and Related Professionals","label_hi":null,"description_en":"Biologists, botanists, zoologists and related professionals study living organisms and their interactions with each other and with the environment, and apply this knowledge to solve human health and environmental problems. They work in diverse fields such as botany, zoology, ecology, marine biology, genetics, immunology, pharmacology, toxicology, physiology, bacteriology and virology.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Biologists, Botanists, Zoologists and Related Professionals","lang":"en","source":"isco08"},{"text":"Animal behaviourist","lang":"en","source":"isco08"},{"text":"Bacteriologist","lang":"en","source":"isco08"},{"text":"Biochemist","lang":"en","source":"isco08"},{"text":"Biologist","lang":"en","source":"isco08"},{"text":"Biomedical researcher","lang":"en","source":"isco08"},{"text":"Biotechnologist","lang":"en","source":"isco08"},{"text":"Botanist","lang":"en","source":"isco08"},{"text":"Cell geneticist","lang":"en","source":"isco08"},{"text":"Marine biologist","lang":"en","source":"isco08"},{"text":"Microbiologist","lang":"en","source":"isco08"},{"text":"Molecular biologist","lang":"en","source":"isco08"},{"text":"Molecular geneticist","lang":"en","source":"isco08"},{"text":"Pharmacologist","lang":"en","source":"isco08"},{"text":"Zoologist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2132","level":4,"parent_code":"213","isco_major":"2","isco_unit":"2132","skill_level":4,"label_en":"Farming, Forestry and Fisheries Advisers","label_hi":null,"description_en":"Farming, forestry and fisheries advisers study and provide assistance and advice on farm, forestry and fisheries management, including cultivation, fertilization, harvesting, soil erosion and composition, disease prevention, nutrition, crop rotation and marketing. They develop techniques for increasing productivity, and study and develop plans and policies for land and fisheries management.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Farming, Forestry and Fisheries Advisers","lang":"en","source":"isco08"},{"text":"Agronomist","lang":"en","source":"isco08"},{"text":"Fisheries adviser","lang":"en","source":"isco08"},{"text":"Forestry adviser","lang":"en","source":"isco08"},{"text":"Forestry scientist","lang":"en","source":"isco08"},{"text":"Horticultural scientist","lang":"en","source":"isco08"},{"text":"Silviculturist","lang":"en","source":"isco08"},{"text":"Soil scientist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2133","level":4,"parent_code":"213","isco_major":"2","isco_unit":"2133","skill_level":4,"label_en":"Environmental Protection Professionals","label_hi":null,"description_en":"Environmental protection professionals study and assess the effects on the environment of human activity such as air, water and noise pollution, soil contamination, climate change, toxic waste and depletion and degradation of natural resources. They develop plans and solutions to protect, conserve, restore, minimize and prevent further damage to the environment.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Environmental Protection Professionals","lang":"en","source":"isco08"},{"text":"Air pollution analyst","lang":"en","source":"isco08"},{"text":"Conservation officer","lang":"en","source":"isco08"},{"text":"Conservation scientist","lang":"en","source":"isco08"},{"text":"Ecologist","lang":"en","source":"isco08"},{"text":"Environmental adviser","lang":"en","source":"isco08"},{"text":"Environmental auditor","lang":"en","source":"isco08"},{"text":"Environmental consultant","lang":"en","source":"isco08"},{"text":"Environmental research scientist","lang":"en","source":"isco08"},{"text":"Environmental scientist","lang":"en","source":"isco08"},{"text":"Park ranger","lang":"en","source":"isco08"},{"text":"Water quality analyst","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"214","level":3,"parent_code":"21","isco_major":"2","isco_unit":null,"skill_level":4,"label_en":"Engineering Professionals (excluding Electrotechnology)","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"2141","level":4,"parent_code":"214","isco_major":"2","isco_unit":"2141","skill_level":4,"label_en":"Industrial and Production Engineers","label_hi":null,"description_en":"Industrial and production engineers conduct research and design, organize and oversee the construction, operation and maintenance of industrial production processes and installations. They establish programmes for the coordination of manufacturing activities and assess cost effectiveness and safety.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Industrial and Production Engineers","lang":"en","source":"isco08"},{"text":"Industrial efficiency engineer","lang":"en","source":"isco08"},{"text":"Industrial engineer","lang":"en","source":"isco08"},{"text":"Industrial plant engineer","lang":"en","source":"isco08"},{"text":"Production engineer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2142","level":4,"parent_code":"214","isco_major":"2","isco_unit":"2142","skill_level":4,"label_en":"Civil Engineers","label_hi":null,"description_en":"Civil engineers conduct research, advise on, design, and direct construction; manage the operation and maintenance of civil engineering structures; or study and advise on technological aspects of particular materials.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Civil Engineers","lang":"en","source":"isco08"},{"text":"Civil engineer","lang":"en","source":"isco08"},{"text":"Geotechnical engineer","lang":"en","source":"isco08"},{"text":"Structural engineer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2143","level":4,"parent_code":"214","isco_major":"2","isco_unit":"2143","skill_level":4,"label_en":"Environmental Engineers","label_hi":null,"description_en":"Environmental engineers conduct research, advise on, design and direct implementation of solutions to prevent, control or remedy negative impacts of human activity on the environment utilizing a variety of engineering disciplines. They conduct environmental assessments of construction and civil engineering projects and apply engineering principles to pollution control, recycling and waste disposal.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Environmental Engineers","lang":"en","source":"isco08"},{"text":"Air pollution control engineer","lang":"en","source":"isco08"},{"text":"Environmental analyst","lang":"en","source":"isco08"},{"text":"Environmental engineer","lang":"en","source":"isco08"},{"text":"Environmental remediation specialist","lang":"en","source":"isco08"},{"text":"Waste water process engineer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2144","level":4,"parent_code":"214","isco_major":"2","isco_unit":"2144","skill_level":4,"label_en":"Mechanical Engineers","label_hi":null,"description_en":"Mechanical engineers conduct research; advise on, design and direct production of machines, aircraft, ships, machinery and industrial plant, equipment and systems; advise on and direct their functioning, maintenance and repair; or study and advise on mechanical aspects of particular materials, products or processes.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Mechanical Engineers","lang":"en","source":"isco08"},{"text":"Aeronautical engineer","lang":"en","source":"isco08"},{"text":"Engine designer","lang":"en","source":"isco08"},{"text":"Marine architect","lang":"en","source":"isco08"},{"text":"Marine engineer","lang":"en","source":"isco08"},{"text":"Mechanical engineer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2145","level":4,"parent_code":"214","isco_major":"2","isco_unit":"2145","skill_level":4,"label_en":"Chemical Engineers","label_hi":null,"description_en":"Chemical engineers conduct research and develop, advise on and direct commercial-scale chemical processes and production of various substances and items such as crude oil, petroleum derivatives, food and drink products, medicines, or synthetic materials. They direct maintenance and repair of chemical plant and equipment and study and advise on chemical aspects of particular materials, products or processes.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Chemical Engineers","lang":"en","source":"isco08"},{"text":"Chemical engineer","lang":"en","source":"isco08"},{"text":"Fuel technologist","lang":"en","source":"isco08"},{"text":"Plastics technologist","lang":"en","source":"isco08"},{"text":"Refinery process engineer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2146","level":4,"parent_code":"214","isco_major":"2","isco_unit":"2146","skill_level":4,"label_en":"Mining Engineers, Metallurgists and Related Professionals","label_hi":null,"description_en":"Mining engineers, metallurgists and related professionals conduct research on, design, develop and maintain commercial-scale methods of extracting metals from their ores, or minerals, water, oil or gas from the earth, and of developing new alloys, ceramic and other materials, or study and advise on mining or metallurgical aspects of particular materials, products or processes.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Mining Engineers, Metallurgists and Related Professionals","lang":"en","source":"isco08"},{"text":"Extractive metallurgist","lang":"en","source":"isco08"},{"text":"Mining engineer","lang":"en","source":"isco08"},{"text":"Petroleum and natural gas extraction engineer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2149","level":4,"parent_code":"214","isco_major":"2","isco_unit":"2149","skill_level":4,"label_en":"Engineering Professionals Not Elsewhere Classified","label_hi":null,"description_en":"This unit group covers engineering professionals not classified elsewhere in Minor Group 214: Engineering Professionals (excluding Electrotechnology) or in Minor Group 215: Electrotechnology Engineers. For instance, the group includes those who conduct research and advise on or develop engineering procedures and solutions concerning workplace safety, biomedical engineering, optics, materials, nuclear power generation and explosives.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Engineering Professionals Not Elsewhere Classified","lang":"en","source":"isco08"},{"text":"Biomedical engineer","lang":"en","source":"isco08"},{"text":"Explosive ordnance engineer","lang":"en","source":"isco08"},{"text":"Marine salvage engineer","lang":"en","source":"isco08"},{"text":"Materials engineer","lang":"en","source":"isco08"},{"text":"Nuclear power generation engineer","lang":"en","source":"isco08"},{"text":"Optical engineer","lang":"en","source":"isco08"},{"text":"Quantity surveyor","lang":"en","source":"isco08"},{"text":"Safety engineer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"215","level":3,"parent_code":"21","isco_major":"2","isco_unit":null,"skill_level":4,"label_en":"Electrotechnology Engineers","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"2151","level":4,"parent_code":"215","isco_major":"2","isco_unit":"2151","skill_level":4,"label_en":"Electrical Engineers","label_hi":null,"description_en":"Electrical engineers conduct research and advise on, design and direct the construction and operation of electrical systems, components, motors and equipment, and advise on and direct their functioning, maintenance and repair, or study and advise on technological aspects of electrical engineering materials, products and processes.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Electrical Engineers","lang":"en","source":"isco08"},{"text":"Electrical engineer","lang":"en","source":"isco08"},{"text":"Electric power generation engineer","lang":"en","source":"isco08"},{"text":"Electromechanical engineer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2152","level":4,"parent_code":"215","isco_major":"2","isco_unit":"2152","skill_level":4,"label_en":"Electronics Engineers","label_hi":null,"description_en":"Electronics engineers conduct research on, design and direct the construction functioning, maintenance and repair of electronic systems, and study and advise on technological aspects of electronic engineering materials, products or processes.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Electronics Engineers","lang":"en","source":"isco08"},{"text":"Computer hardware engineer","lang":"en","source":"isco08"},{"text":"Electronics engineer","lang":"en","source":"isco08"},{"text":"Instrumentation engineer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2153","level":4,"parent_code":"215","isco_major":"2","isco_unit":"2153","skill_level":4,"label_en":"Telecommunications Engineers","label_hi":null,"description_en":"Telecommunications engineers conduct research and advise on, design and direct the construction, functioning, maintenance and repair of telecommunication systems and equipment. They study and advise on technological aspects of telecommunication engineering materials, products or processes.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Telecommunications Engineers","lang":"en","source":"isco08"},{"text":"Broadcast engineer","lang":"en","source":"isco08"},{"text":"Telecommunications engineer","lang":"en","source":"isco08"},{"text":"Telecommunications engineering technologist","lang":"en","source":"isco08"}]}
