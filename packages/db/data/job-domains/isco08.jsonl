{"source":"isco08","code":"3121","level":4,"parent_code":"312","isco_major":"3","isco_unit":"3121","skill_level":3,"label_en":"Mining Supervisors","label_hi":null,"description_en":"Mining supervisors oversee mining and quarrying operations and directly supervise and coordinate the activities of miners working in underground and surface mines and quarries.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Mining Supervisors","lang":"en","source":"isco08"},{"text":"Mine deputy","lang":"en","source":"isco08"},{"text":"Mine supervisor","lang":"en","source":"isco08"},{"text":"Mine under-manager","lang":"en","source":"isco08"},{"text":"Quarry supervisor","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3122","level":4,"parent_code":"312","isco_major":"3","isco_unit":"3122","skill_level":3,"label_en":"Manufacturing Supervisors","label_hi":null,"description_en":"Manufacturing supervisors coordinate and supervise the activities of process control technicians, machine operators, assemblers and other manufacturing labourers.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Manufacturing Supervisors","lang":"en","source":"isco08"},{"text":"Area coordinator (manufacturing)","lang":"en","source":"isco08"},{"text":"Assembly supervisor","lang":"en","source":"isco08"},{"text":"Finishing supervisor","lang":"en","source":"isco08"},{"text":"Production supervisor (manufacturing)","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3123","level":4,"parent_code":"312","isco_major":"3","isco_unit":"3123","skill_level":3,"label_en":"Construction Supervisors","label_hi":null,"description_en":"Construction supervisors, coordinate, supervise and schedule the activities of workers engaged in the construction and repair of buildings and structures.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Construction Supervisors","lang":"en","source":"isco08"},{"text":"Building construction supervisor","lang":"en","source":"isco08"},{"text":"Site manager (construction)","lang":"en","source":"isco08"}]}
