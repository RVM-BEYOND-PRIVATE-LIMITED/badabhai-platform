{"source":"isco08","code":"3151","level":4,"parent_code":"315","isco_major":"3","isco_unit":"3151","skill_level":3,"label_en":"Ships' Engineers","label_hi":null,"description_en":"Ships’ engineers control and participate in the operation, maintenance and repair of mechanical, electrical and electronic equipment and machinery on board ship, or perform related supporting functions on shore.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Ships' Engineers","lang":"en","source":"isco08"},{"text":"Ships' Engineer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3152","level":4,"parent_code":"315","isco_major":"3","isco_unit":"3152","skill_level":3,"label_en":"Ships' Deck Officers and Pilots","label_hi":null,"description_en":"Ships’ deck officers and pilots command and navigate ships and similar vessels, and perform related functions on shore.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Ships' Deck Officers and Pilots","lang":"en","source":"isco08"},{"text":"Pilot (ship)","lang":"en","source":"isco08"},{"text":"Ship's captain","lang":"en","source":"isco08"},{"text":"Skipper (yacht)","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3153","level":4,"parent_code":"315","isco_major":"3","isco_unit":"3153","skill_level":3,"label_en":"Aircraft Pilots and Related Associate Professionals","label_hi":null,"description_en":"Aircraft pilots and related associate professionals control the operation of mechanical, electrical and electronic equipment, in order to navigate aircraft for transporting passengers, mail and freight, and perform related pre-flight and in-flight tasks.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Aircraft Pilots and Related Associate Professionals","lang":"en","source":"isco08"},{"text":"Aerial crop sprayer","lang":"en","source":"isco08"},{"text":"Flight Engineer","lang":"en","source":"isco08"},{"text":"Flying instructor","lang":"en","source":"isco08"},{"text":"Navigator (flight)","lang":"en","source":"isco08"},{"text":"Pilot (aircraft)","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3154","level":4,"parent_code":"315","isco_major":"3","isco_unit":"3154","skill_level":3,"label_en":"Air Traffic Controllers","label_hi":null,"description_en":"Air traffic controllers direct aircraft movements in airspace and on the ground, using radio, radar and lighting systems, and provide information relevant to the operation of aircraft.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Air Traffic Controllers","lang":"en","source":"isco08"},{"text":"Air traffic controller","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3155","level":4,"parent_code":"315","isco_major":"3","isco_unit":"3155","skill_level":3,"label_en":"Air Traffic Safety Electronics Technicians","label_hi":null,"description_en":"Air traffic safety electronics technicians perform technical tasks concerning the design, installation, management, operation, maintenance and repair of air traffic control and air navigation systems.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Air Traffic Safety Electronics Technicians","lang":"en","source":"isco08"},{"text":"Air traffic safety engineer","lang":"en","source":"isco08"},{"text":"Air traffic safety technician","lang":"en","source":"isco08"}]}
