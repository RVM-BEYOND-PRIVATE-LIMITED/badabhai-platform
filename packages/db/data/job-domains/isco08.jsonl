{"source":"isco08","code":"8153","level":4,"parent_code":"815","isco_major":"8","isco_unit":"8153","skill_level":2,"label_en":"Sewing Machine Operators","label_hi":null,"description_en":"Sewing machine operators monitor and operate sewing machines to make, repair, darn and renovate textile, fur, synthetic or leather garments or embroider ornamental designs on garments or other materials. They operate buttonhole making and eyelet holing machines to cut holes, stitch around holes, stitch buttons and fix eyelets to garments.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Sewing Machine Operators","lang":"en","source":"isco08"},{"text":"Embroidery machine operator","lang":"en","source":"isco08"},{"text":"Sewing machine operator","lang":"en","source":"isco08"},{"text":"Machinist, sewing","lang":"en","source":"isco08"},{"text":"Operator, machine: embroidery","lang":"en","source":"isco08"},{"text":"Operator, machine: sewing","lang":"en","source":"isco08"}]}
