{"source":"isco08","code":"3230","level":4,"parent_code":"323","isco_major":"3","isco_unit":"3230","skill_level":3,"label_en":"Traditional and Complementary Medicine Associate Professionals","label_hi":null,"description_en":"Traditional and complementary medicine associate professionals prevent, care for and treat human physical and mental illnesses, disorders and injuries using herbal and other therapies based on theories, beliefs and experiences originating in specific cultures. They administer treatments using traditional techniques and medicaments, either acting independently or according to therapeutic care plans established by a traditional medicine or other health professional.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Traditional and Complementary Medicine Associate Professionals","lang":"en","source":"isco08"},{"text":"Acupuncture technician","lang":"en","source":"isco08"},{"text":"Ayurvedic technician","lang":"en","source":"isco08"},{"text":"Bonesetter","lang":"en","source":"isco08"},{"text":"Herbalist","lang":"en","source":"isco08"},{"text":"Homeopathy technician","lang":"en","source":"isco08"},{"text":"Scraping and cupping therapist","lang":"en","source":"isco08"},{"text":"Village healer","lang":"en","source":"isco08"},{"text":"Witch doctor","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"324","level":3,"parent_code":"32","isco_major":"3","isco_unit":null,"skill_level":3,"label_en":"Veterinary Technicians and Assistants","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"3240","level":4,"parent_code":"324","isco_major":"3","isco_unit":"3240","skill_level":3,"label_en":"Veterinary Technicians and Assistants","label_hi":null,"description_en":"Veterinary technicians and assistants carry out advisory, diagnostic, preventive and curative veterinary tasks more limited in scope and complexity than those carried out by, and with the guidance of, veterinarians. They care for animals under treatment and in temporary residence at veterinary facilities, perform routine procedures and assist veterinarians to perform procedures and operations.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Veterinary Technicians and Assistants","lang":"en","source":"isco08"},{"text":"Artificial inseminator","lang":"en","source":"isco08"},{"text":"Veterinary assistant","lang":"en","source":"isco08"},{"text":"Veterinary nurse","lang":"en","source":"isco08"},{"text":"Veterinary vaccinator","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"325","level":3,"parent_code":"32","isco_major":"3","isco_unit":null,"skill_level":3,"label_en":"Other Health Associate Professionals","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"3251","level":4,"parent_code":"325","isco_major":"3","isco_unit":"3251","skill_level":3,"label_en":"Dental Assistants and Therapists","label_hi":null,"description_en":"Dental assistants and therapists provide basic dental care services for the prevention and treatment of diseases and disorders of the teeth and mouth, according to care plans and procedures established by a dentist or other oral health professional.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Dental Assistants and Therapists","lang":"en","source":"isco08"},{"text":"Dental assistant","lang":"en","source":"isco08"},{"text":"Dental hygienist","lang":"en","source":"isco08"},{"text":"Dental therapist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3252","level":4,"parent_code":"325","isco_major":"3","isco_unit":"3252","skill_level":3,"label_en":"Medical Records and Health Information Technicians","label_hi":null,"description_en":"Medical records and health information technicians develop, maintain and implement health records processing, storage and retrieval systems in medical facilities and other health care settings to meet the legal professional, ethical and administrative records-keeping requirements of health services delivery.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Medical Records and Health Information Technicians","lang":"en","source":"isco08"},{"text":"Clinical coder","lang":"en","source":"isco08"},{"text":"Disease registry technician","lang":"en","source":"isco08"},{"text":"Health information clerk","lang":"en","source":"isco08"},{"text":"Medical records analyst","lang":"en","source":"isco08"},{"text":"Medical records clerk","lang":"en","source":"isco08"},{"text":"Medical records technician","lang":"en","source":"isco08"},{"text":"Medical records unit supervisor","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3253","level":4,"parent_code":"325","isco_major":"3","isco_unit":"3253","skill_level":3,"label_en":"Community Health Workers","label_hi":null,"description_en":"Community health workers provide health education, referral and follow up, case management, basic preventive health care and home visiting services to specific communities. They provide support and assistance to individuals and families in navigating the health and social services system.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Community Health Workers","lang":"en","source":"isco08"},{"text":"Community health aide","lang":"en","source":"isco08"},{"text":"Community health promoter","lang":"en","source":"isco08"},{"text":"Community health worker","lang":"en","source":"isco08"},{"text":"Village health worker","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3254","level":4,"parent_code":"325","isco_major":"3","isco_unit":"3254","skill_level":3,"label_en":"Dispensing Opticians","label_hi":null,"description_en":"Dispensing opticians design, fit and dispense optical lenses based on a prescription from an ophthalmologist or optometrist for the correction of reduced visual acuity. They service corrective eyeglasses, contact lenses, low-vision aids and other optical devices.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Dispensing Opticians","lang":"en","source":"isco08"},{"text":"Contact lens optician","lang":"en","source":"isco08"},{"text":"Dispensing optician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3255","level":4,"parent_code":"325","isco_major":"3","isco_unit":"3255","skill_level":3,"label_en":"Physiotherapy Technicians and Assistants","label_hi":null,"description_en":"Physiotherapy technicians and assistants provide physical therapeutic treatments to patients in circumstances where functional movement is threatened by injury, disease or impairment. Therapies are usually provided as per rehabilitative plans established by a physiotherapist or other health professional.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Physiotherapy Technicians and Assistants","lang":"en","source":"isco08"},{"text":"Acupressure therapist","lang":"en","source":"isco08"},{"text":"Electrotherapist","lang":"en","source":"isco08"},{"text":"Hydrotherapist","lang":"en","source":"isco08"},{"text":"Massage therapist","lang":"en","source":"isco08"},{"text":"Physical rehabilitation technician","lang":"en","source":"isco08"},{"text":"Physiotherapy technician","lang":"en","source":"isco08"},{"text":"Shiatsu therapist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3256","level":4,"parent_code":"325","isco_major":"3","isco_unit":"3256","skill_level":3,"label_en":"Medical Assistants","label_hi":null,"description_en":"Medical assistants perform basic clinical and administrative tasks to support patient care under the direct supervision of a medical practitioner or other health professional.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Medical Assistants","lang":"en","source":"isco08"},{"text":"Clinical assistant","lang":"en","source":"isco08"},{"text":"Medical assistant","lang":"en","source":"isco08"},{"text":"Ophthalmic assistant","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3257","level":4,"parent_code":"325","isco_major":"3","isco_unit":"3257","skill_level":3,"label_en":"Environmental and Occupational Health Inspectors and Associates","label_hi":null,"description_en":"Environmental and occupational health inspectors and associates investigate the implementation of rules and regulations relating to environmental factors that may affect human health, safety in the workplace, and safety of processes for the production of goods and services. They may implement and evaluate programmes to restore or improve safety and sanitary conditions under the supervision of a health professional.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Environmental and Occupational Health Inspectors and Associates","lang":"en","source":"isco08"},{"text":"Food sanitation and safety inspector","lang":"en","source":"isco08"},{"text":"Health inspector","lang":"en","source":"isco08"},{"text":"Occupational health and safety inspector","lang":"en","source":"isco08"},{"text":"Pollution inspector","lang":"en","source":"isco08"},{"text":"Production safety inspector","lang":"en","source":"isco08"},{"text":"Sanitarian","lang":"en","source":"isco08"},{"text":"Sanitary inspector","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3258","level":4,"parent_code":"325","isco_major":"3","isco_unit":"3258","skill_level":3,"label_en":"Ambulance Workers","label_hi":null,"description_en":"Ambulance workers provide emergency health care to patients who are injured, sick, infirm, or otherwise physically or mentally impaired prior to and during transport to medical facilities.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Ambulance Workers","lang":"en","source":"isco08"},{"text":"Ambulance officer","lang":"en","source":"isco08"},{"text":"Ambulance paramedic","lang":"en","source":"isco08"},{"text":"Emergency medical technician","lang":"en","source":"isco08"},{"text":"Emergency paramedic","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3259","level":4,"parent_code":"325","isco_major":"3","isco_unit":"3259","skill_level":3,"label_en":"Health Associate Professionals Not Elsewhere Classified","label_hi":null,"description_en":"This unit group covers health associate professionals not classified elsewhere in Sub-major Group 32: Health Associate Professionals. For instance, the group includes occupations such as HIV counsellor, family planning counsellor and other health associate professionals.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Health Associate Professionals Not Elsewhere Classified","lang":"en","source":"isco08"},{"text":"Anaesthesia technician","lang":"en","source":"isco08"},{"text":"Family planning counsellor","lang":"en","source":"isco08"},{"text":"HIV counsellor","lang":"en","source":"isco08"},{"text":"Respiratory therapy technician","lang":"en","source":"isco08"}]}
