{"source":"isco08","code":"2631","level":4,"parent_code":"263","isco_major":"2","isco_unit":"2631","skill_level":4,"label_en":"Economists","label_hi":null,"description_en":"Economists conduct research, monitor data, analyse information and prepare reports and plans to resolve economic and business problems and develop models to analyse, explain and forecast economic behaviour and patterns. They provide advice to business, interest groups and governments to formulate solutions to present or projected economic and business problems.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Economists","lang":"en","source":"isco08"},{"text":"Econometrician","lang":"en","source":"isco08"},{"text":"Economic adviser","lang":"en","source":"isco08"},{"text":"Economic analyst","lang":"en","source":"isco08"},{"text":"Economist","lang":"en","source":"isco08"},{"text":"Labour economist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2632","level":4,"parent_code":"263","isco_major":"2","isco_unit":"2632","skill_level":4,"label_en":"Sociologists, Anthropologists and Related Professionals","label_hi":null,"description_en":"Sociologists, anthropologists and related professionals investigate and describe the structure, origin and evolution of societies and the interdependence between environmental conditions and human activities. They provide advice on the practical application of their findings in the formulation of economic and social policies.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Sociologists, Anthropologists and Related Professionals","lang":"en","source":"isco08"},{"text":"Anthropologist","lang":"en","source":"isco08"},{"text":"Archaeologist","lang":"en","source":"isco08"},{"text":"Criminologist","lang":"en","source":"isco08"},{"text":"Ethnologist","lang":"en","source":"isco08"},{"text":"Geographer","lang":"en","source":"isco08"},{"text":"Sociologist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2633","level":4,"parent_code":"263","isco_major":"2","isco_unit":"2633","skill_level":4,"label_en":"Philosophers, Historians and Political Scientists","label_hi":null,"description_en":"Philosophers, historians and political scientists conduct research into the nature of human experience and existence, phases or aspects of human history, and political structures, movements and behaviour. They document and report on findings to inform and guide political and individual actions","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Philosophers, Historians and Political Scientists","lang":"en","source":"isco08"},{"text":"Genealogist","lang":"en","source":"isco08"},{"text":"Historian","lang":"en","source":"isco08"},{"text":"Philosopher","lang":"en","source":"isco08"},{"text":"Political scientist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2634","level":4,"parent_code":"263","isco_major":"2","isco_unit":"2634","skill_level":4,"label_en":"Psychologists","label_hi":null,"description_en":"Psychologists research into and study the mental processes and behaviour of human beings as individuals or in groups, and apply this knowledge to promote personal, social, educational or occupational adjustment and development.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Psychologists","lang":"en","source":"isco08"},{"text":"Clinical psychologist","lang":"en","source":"isco08"},{"text":"Educational psychologist","lang":"en","source":"isco08"},{"text":"Organizational psychologist","lang":"en","source":"isco08"},{"text":"Psychotherapist","lang":"en","source":"isco08"},{"text":"Sports psychologist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2635","level":4,"parent_code":"263","isco_major":"2","isco_unit":"2635","skill_level":4,"label_en":"Social Work and Counselling Professionals","label_hi":null,"description_en":"Social work and counselling professionals provide advice and guidance to individuals, families, groups, communities and organizations in response to social and personal difficulties. They assist clients to develop skills and access resources and support services needed to respond to issues arising from unemployment, poverty, disability, addiction, criminal and delinquent behaviour, and marital and other problems.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Social Work and Counselling Professionals","lang":"en","source":"isco08"},{"text":"Addictions counsellor","lang":"en","source":"isco08"},{"text":"Bereavement counsellor","lang":"en","source":"isco08"},{"text":"Child and youth counsellor","lang":"en","source":"isco08"},{"text":"District social welfare officer","lang":"en","source":"isco08"},{"text":"Family counsellor","lang":"en","source":"isco08"},{"text":"Marriage counsellor","lang":"en","source":"isco08"},{"text":"Parole officer","lang":"en","source":"isco08"},{"text":"Probation officer","lang":"en","source":"isco08"},{"text":"Sexual assault counsellor","lang":"en","source":"isco08"},{"text":"Social worker","lang":"en","source":"isco08"},{"text":"Women’s welfare organizer","lang":"en","source":"isco08"},{"text":"Women's welfare organizer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2636","level":4,"parent_code":"263","isco_major":"2","isco_unit":"2636","skill_level":4,"label_en":"Religious Professionals","label_hi":null,"description_en":"Religious professionals function as perpetuators of sacred traditions, practices and beliefs. They conduct religious services, celebrate or administer the rites of a religious faith or denomination, provide spiritual and moral guidance and perform other functions associated with the practice of a religion.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Religious Professionals","lang":"en","source":"isco08"},{"text":"Bonze","lang":"en","source":"isco08"},{"text":"Imam","lang":"en","source":"isco08"},{"text":"Minister of religion","lang":"en","source":"isco08"},{"text":"Poojari","lang":"en","source":"isco08"},{"text":"Priest","lang":"en","source":"isco08"},{"text":"Rabbi","lang":"en","source":"isco08"}]}
