{"source":"isco08","code":"5414","level":4,"parent_code":"541","isco_major":"5","isco_unit":"5414","skill_level":2,"label_en":"Security Guards","label_hi":null,"description_en":"Security guards patrol or monitor premises to guard property against theft and vandalism. They control access to establishments and maintain order and enforce regulations at public events and within establishments.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Security Guards","lang":"en","source":"isco08"},{"text":"Bodyguard","lang":"en","source":"isco08"},{"text":"Doorkeeper","lang":"en","source":"isco08"},{"text":"Museum guard","lang":"en","source":"isco08"},{"text":"Security guard","lang":"en","source":"isco08"},{"text":"Security patrolman/woman","lang":"en","source":"isco08"},{"text":"Watchman/woman","lang":"en","source":"isco08"},{"text":"Bouncer","lang":"en","source":"isco08"},{"text":"Concierge, hotel","lang":"en","source":"isco08"},{"text":"Consultant, security","lang":"en","source":"isco08"},{"text":"Guard, art gallery","lang":"en","source":"isco08"},{"text":"Guard, body","lang":"en","source":"isco08"},{"text":"Guard, museum","lang":"en","source":"isco08"},{"text":"Guard, security","lang":"en","source":"isco08"},{"text":"Keeper, door","lang":"en","source":"isco08"},{"text":"Nightwatchman","lang":"en","source":"isco08"},{"text":"Nightwatchwoman","lang":"en","source":"isco08"},{"text":"Officer, security: guard","lang":"en","source":"isco08"},{"text":"Patrolman, security","lang":"en","source":"isco08"},{"text":"Patrolwoman, security","lang":"en","source":"isco08"},{"text":"Specialist, security (except computer)","lang":"en","source":"isco08"},{"text":"Watchman","lang":"en","source":"isco08"},{"text":"Watchwoman","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"5419","level":4,"parent_code":"541","isco_major":"5","isco_unit":"5419","skill_level":2,"label_en":"Protective Services Workers Not Elsewhere Classified","label_hi":null,"description_en":"This unit group covers protective services workers not classified elsewhere in Minor Group 541: Protective Services Workers. For instance, the unit group includes lifeguards, crossing guards and animal control officers.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Protective Services Workers Not Elsewhere Classified","lang":"en","source":"isco08"},{"text":"Animal control officer","lang":"en","source":"isco08"},{"text":"Beach patrolman/woman","lang":"en","source":"isco08"},{"text":"Crossing guard","lang":"en","source":"isco08"},{"text":"Game warden","lang":"en","source":"isco08"},{"text":"Lifeguard","lang":"en","source":"isco08"},{"text":"Traffic warden","lang":"en","source":"isco08"},{"text":"Attendant, pool","lang":"en","source":"isco08"},{"text":"Attendant, swimming pool","lang":"en","source":"isco08"},{"text":"Coastguard","lang":"en","source":"isco08"},{"text":"Gamewarden","lang":"en","source":"isco08"},{"text":"Guard, beach","lang":"en","source":"isco08"},{"text":"Guard, crossing","lang":"en","source":"isco08"},{"text":"Lifesaver, surf","lang":"en","source":"isco08"},{"text":"Officer, animal control","lang":"en","source":"isco08"},{"text":"Officer, civil defence","lang":"en","source":"isco08"},{"text":"Patrolman, beach","lang":"en","source":"isco08"},{"text":"Patrolwoman, beach","lang":"en","source":"isco08"},{"text":"Warden, bird sanctuary","lang":"en","source":"isco08"},{"text":"Warden, game","lang":"en","source":"isco08"},{"text":"Warden, traffic","lang":"en","source":"isco08"},{"text":"Warden, wild life","lang":"en","source":"isco08"}]}
