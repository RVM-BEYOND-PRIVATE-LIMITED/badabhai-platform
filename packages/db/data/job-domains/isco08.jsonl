{"source":"isco08","code":"7521","level":4,"parent_code":"752","isco_major":"7","isco_unit":"7521","skill_level":2,"label_en":"Wood Treaters","label_hi":null,"description_en":"Wood treaters season, preserve and treat wood and lumber manually or using wood treatment equipment such as kilns and tanks.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Wood Treaters","lang":"en","source":"isco08"},{"text":"Dry kiln operator","lang":"en","source":"isco08"},{"text":"Lumber kiln operator","lang":"en","source":"isco08"},{"text":"Timber treating tank operator","lang":"en","source":"isco08"},{"text":"Veneer dryer tender","lang":"en","source":"isco08"},{"text":"Wood seasoner","lang":"en","source":"isco08"},{"text":"Wood treater","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"7522","level":4,"parent_code":"752","isco_major":"7","isco_unit":"7522","skill_level":2,"label_en":"Cabinet-makers and Related Workers","label_hi":null,"description_en":"Cabinet-makers and related workers make, decorate and repair wooden furniture, carts and other vehicles, wheels, parts, fittings, patterns, models and other wooden products using woodworking machines, machine tools and specialized hand tools.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Cabinet-makers and Related Workers","lang":"en","source":"isco08"},{"text":"Cabinet-maker","lang":"en","source":"isco08"},{"text":"Cartwright","lang":"en","source":"isco08"},{"text":"Furniture cabinet-maker","lang":"en","source":"isco08"},{"text":"Wheelwright","lang":"en","source":"isco08"},{"text":"Wood patternmaker","lang":"en","source":"isco08"}]}
