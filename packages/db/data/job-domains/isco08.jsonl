{"source":"isco08","code":"3221","level":4,"parent_code":"322","isco_major":"3","isco_unit":"3221","skill_level":3,"label_en":"Nursing Associate Professionals","label_hi":null,"description_en":"Nursing associate professionals provide basic nursing and personal care for people in need of such care due to effects of ageing, illness, injury or other physical or mental impairment. They generally work under the supervision of, and in support of implementation of health care, treatment and referrals plans established by, medical, nursing and other health professionals.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Nursing Associate Professionals","lang":"en","source":"isco08"},{"text":"Assistant nurse","lang":"en","source":"isco08"},{"text":"Associate professional nurse","lang":"en","source":"isco08"},{"text":"Enrolled nurse","lang":"en","source":"isco08"},{"text":"Practical nurse","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3222","level":4,"parent_code":"322","isco_major":"3","isco_unit":"3222","skill_level":3,"label_en":"Midwifery Associate Professionals","label_hi":null,"description_en":"Midwifery associate professionals provide basic health care and advice before, during and after pregnancy and childbirth. They implement care, treatment and referral plans usually established by medical, midwifery and other health professionals.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Midwifery Associate Professionals","lang":"en","source":"isco08"},{"text":"Assistant midwife","lang":"en","source":"isco08"},{"text":"Traditional midwife","lang":"en","source":"isco08"}]}
