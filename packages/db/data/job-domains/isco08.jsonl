{"source":"isco08","code":"3211","level":4,"parent_code":"321","isco_major":"3","isco_unit":"3211","skill_level":3,"label_en":"Medical Imaging and Therapeutic Equipment Technicians","label_hi":null,"description_en":"Medical imaging and therapeutic equipment technicians test and operate radiographic, ultrasound and other medical imaging equipment to produce images of body structures for the diagnosis and treatment of injury, disease and other impairments. They may administer radiation treatments to patients under the supervision of a radiologist or other health professional.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Medical Imaging and Therapeutic Equipment Technicians","lang":"en","source":"isco08"},{"text":"Diagnostic medical radiographer","lang":"en","source":"isco08"},{"text":"Magnetic resonance imaging technologist","lang":"en","source":"isco08"},{"text":"Mammographer","lang":"en","source":"isco08"},{"text":"Medical radiation therapist","lang":"en","source":"isco08"},{"text":"Nuclear medicine technologist","lang":"en","source":"isco08"},{"text":"Radiographer","lang":"en","source":"isco08"},{"text":"Sonographer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3212","level":4,"parent_code":"321","isco_major":"3","isco_unit":"3212","skill_level":3,"label_en":"Medical and Pathology Laboratory Technicians","label_hi":null,"description_en":"Medical and pathology laboratory technicians perform clinical tests on specimens of bodily fluids and tissues in order to obtain information about the health of a patient or cause of death.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Medical and Pathology Laboratory Technicians","lang":"en","source":"isco08"},{"text":"Blood-bank technician","lang":"en","source":"isco08"},{"text":"Cytology technician","lang":"en","source":"isco08"},{"text":"Medical laboratory technician","lang":"en","source":"isco08"},{"text":"Pathology technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3213","level":4,"parent_code":"321","isco_major":"3","isco_unit":"3213","skill_level":3,"label_en":"Pharmaceutical Technicians and Assistants","label_hi":null,"description_en":"Pharmaceutical technicians and assistants perform a variety of tasks associated with dispensing medicinal products under the guidance of a pharmacist or other health professional.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Pharmaceutical Technicians and Assistants","lang":"en","source":"isco08"},{"text":"Dispensing technician","lang":"en","source":"isco08"},{"text":"Pharmaceutical assistant","lang":"en","source":"isco08"},{"text":"Pharmaceutical technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3214","level":4,"parent_code":"321","isco_major":"3","isco_unit":"3214","skill_level":3,"label_en":"Medical and Dental Prosthetic Technicians","label_hi":null,"description_en":"Medical and dental prosthetic technicians design, fit, service and repair medical and dental devices and appliances following prescriptions or instructions established by a health professional. They may service a wide range of support instruments to correct physical medical or dental problems such as neck braces, orthopaedic splints, artificial limbs, hearing aids, arch supports, dentures, and dental crowns and bridges.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Medical and Dental Prosthetic Technicians","lang":"en","source":"isco08"},{"text":"Dental mechanic","lang":"en","source":"isco08"},{"text":"Dental technician","lang":"en","source":"isco08"},{"text":"Denturist","lang":"en","source":"isco08"},{"text":"Orthopaedic appliance maker","lang":"en","source":"isco08"},{"text":"Orthotic technician","lang":"en","source":"isco08"},{"text":"Orthotist","lang":"en","source":"isco08"},{"text":"Prosthetic technician","lang":"en","source":"isco08"},{"text":"Prosthetist","lang":"en","source":"isco08"}]}
