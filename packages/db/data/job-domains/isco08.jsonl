{"source":"isco08","code":"6111","level":4,"parent_code":"611","isco_major":"6","isco_unit":"6111","skill_level":2,"label_en":"Field Crop and Vegetable Growers","label_hi":null,"description_en":"Field crop and vegetable growers plan, organize and perform farming operations to grow and harvest various types of field crop such as wheat and other cereals, rice, beetroot, sugar-cane, ground-nuts, tobacco, reed or other field crops and potatoes, cabbages or other field vegetables, for sale or delivery on a regular basis to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Field Crop and Vegetable Growers","lang":"en","source":"isco08"},{"text":"Cereal farmer","lang":"en","source":"isco08"},{"text":"Cotton farmer","lang":"en","source":"isco08"},{"text":"Potato farmer","lang":"en","source":"isco08"},{"text":"Rice farmer","lang":"en","source":"isco08"},{"text":"Skilled farm worker (field crops)","lang":"en","source":"isco08"},{"text":"Sugar-cane grower","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"6112","level":4,"parent_code":"611","isco_major":"6","isco_unit":"6112","skill_level":2,"label_en":"Tree and Shrub Crop Growers","label_hi":null,"description_en":"Tree and shrub crop growers plan, organize and perform farming operations to grow and harvest trees and shrubs, such as fruit and nut trees, tea and coffee bushes, grape vines, berry-bearing bushes, cocoa trees and rubber trees, and to collect sap, for sale or delivery on a regular basis to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Tree and Shrub Crop Growers","lang":"en","source":"isco08"},{"text":"Fruit farmer","lang":"en","source":"isco08"},{"text":"Rubber farmer","lang":"en","source":"isco08"},{"text":"Rubber tapper","lang":"en","source":"isco08"},{"text":"Tea grower","lang":"en","source":"isco08"},{"text":"Viticulturist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"6113","level":4,"parent_code":"611","isco_major":"6","isco_unit":"6113","skill_level":2,"label_en":"Gardeners, Horticultural and Nursery Growers","label_hi":null,"description_en":"Gardeners, horticultural and nursery growers plan, organize and perform operations to cultivate and maintain trees, shrubs, flowers and other plants in parks and private gardens, and to produce saplings, bulbs and seeds or grow vegetables and flowers by intensive cultivation techniques, for sale or delivery on a regular basis to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Gardeners, Horticultural and Nursery Growers","lang":"en","source":"isco08"},{"text":"Horticulturist","lang":"en","source":"isco08"},{"text":"Landscape gardener","lang":"en","source":"isco08"},{"text":"Market gardener","lang":"en","source":"isco08"},{"text":"Mushroom cultivator","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"6114","level":4,"parent_code":"611","isco_major":"6","isco_unit":"6114","skill_level":2,"label_en":"Mixed Crop Growers","label_hi":null,"description_en":"Mixed crop growers plan, organize and perform farming operations to grow and harvest specific combinations of field crops, field vegetables, tree and shrub crops, and garden, horticultural and nursery products, for sale or delivery to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Mixed Crop Growers","lang":"en","source":"isco08"},{"text":"Mixed crop farmer","lang":"en","source":"isco08"},{"text":"Skilled farm worker (mixed crops)","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"612","level":3,"parent_code":"61","isco_major":"6","isco_unit":null,"skill_level":2,"label_en":"Animal Producers","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"6121","level":4,"parent_code":"612","isco_major":"6","isco_unit":"6121","skill_level":2,"label_en":"Livestock and Dairy Producers","label_hi":null,"description_en":"Livestock and dairy producers plan, organize and perform farming operations to breed and raise domesticated animals (excluding poultry), such as cattle, sheep, pigs, goats, horses and camels, for the production of meat, milk and other dairy products, skins and wool or for use as working, sporting or recreational animals, for sale or delivery to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Livestock and Dairy Producers","lang":"en","source":"isco08"},{"text":"Cattle farmer","lang":"en","source":"isco08"},{"text":"Dairy farmer","lang":"en","source":"isco08"},{"text":"Dog breeder","lang":"en","source":"isco08"},{"text":"Drover","lang":"en","source":"isco08"},{"text":"Goat farmer","lang":"en","source":"isco08"},{"text":"Horse breeder","lang":"en","source":"isco08"},{"text":"Shearer","lang":"en","source":"isco08"},{"text":"Sheep farmer","lang":"en","source":"isco08"},{"text":"Shepherd","lang":"en","source":"isco08"},{"text":"Stockman/woman","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"6122","level":4,"parent_code":"612","isco_major":"6","isco_unit":"6122","skill_level":2,"label_en":"Poultry Producers","label_hi":null,"description_en":"Poultry producers plan, organize and perform farming operations to breed and raise chickens, turkeys, geese, ducks and other poultry to produce meat, eggs and breeding stock for sale or delivery to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Poultry Producers","lang":"en","source":"isco08"},{"text":"Poultry breeder","lang":"en","source":"isco08"},{"text":"Poultry farmer","lang":"en","source":"isco08"},{"text":"Poultry tender","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"6123","level":4,"parent_code":"612","isco_major":"6","isco_unit":"6123","skill_level":2,"label_en":"Apiarists and Sericulturists","label_hi":null,"description_en":"Apiarists and sericulturists plan, organize and perform operations to breed, raise and tend insects such as honey bees, silkworms, and other species to produce honey, beeswax, silk and other products for sale or delivery to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Apiarists and Sericulturists","lang":"en","source":"isco08"},{"text":"Apiarist","lang":"en","source":"isco08"},{"text":"Sericulturist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"6129","level":4,"parent_code":"612","isco_major":"6","isco_unit":"6129","skill_level":2,"label_en":"Animal Producers Not Elsewhere Classified","label_hi":null,"description_en":"This unit group covers market-oriented animal producers not classified elsewhere in Minor Group 612: Animal producers. For instance, the group includes those engaged in breeding, raising and tending non-domesticated mammals, game and other birds (except poultry), snails, snakes and other reptiles, as well as various insects and animals used for laboratory tests, for sale or delivery on a regular basis to wholesale buyers, marketing organizations, zoos and circuses, or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Animal Producers Not Elsewhere Classified","lang":"en","source":"isco08"},{"text":"Crocodile farmer","lang":"en","source":"isco08"},{"text":"Fur farmer (non-domesticated animals)","lang":"en","source":"isco08"},{"text":"Game bird breeder","lang":"en","source":"isco08"},{"text":"Ostrich farmer","lang":"en","source":"isco08"},{"text":"Snail breeder","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"613","level":3,"parent_code":"61","isco_major":"6","isco_unit":null,"skill_level":2,"label_en":"Mixed Crop and Animal Producers","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"6130","level":4,"parent_code":"613","isco_major":"6","isco_unit":"6130","skill_level":2,"label_en":"Mixed Crop and Animal Producers","label_hi":null,"description_en":"Mixed crop and animal producers plan, organize and perform farming operations to grow and harvest field, tree and various other crops, as well as to breed, raise and tend animals and to produce a variety of animal husbandry products, for sale or delivery to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Mixed Crop and Animal Producers","lang":"en","source":"isco08"},{"text":"Farmer (mixed farming)","lang":"en","source":"isco08"},{"text":"Skilled farm worker (mixed farming)","lang":"en","source":"isco08"}]}
