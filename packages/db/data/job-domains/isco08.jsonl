{"source":"isco08","code":"6210","level":4,"parent_code":"621","isco_major":"6","isco_unit":"6210","skill_level":2,"label_en":"Forestry and Related Workers","label_hi":null,"description_en":"Forestry and related workers plan, organize and perform operations to cultivate, conserve and exploit natural and plantation forests.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Forestry and Related Workers","lang":"en","source":"isco08"},{"text":"Charcoal burner","lang":"en","source":"isco08"},{"text":"Logger","lang":"en","source":"isco08"},{"text":"Logging climber","lang":"en","source":"isco08"},{"text":"Skilled forestry worker","lang":"en","source":"isco08"},{"text":"Timber cruiser","lang":"en","source":"isco08"},{"text":"Tree feller","lang":"en","source":"isco08"}]}
