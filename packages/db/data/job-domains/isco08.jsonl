{"source":"isco08","code":"1439","level":4,"parent_code":"143","isco_major":"1","isco_unit":"1439","skill_level":null,"label_en":"Services Managers Not Elsewhere Classified","label_hi":null,"description_en":"This unit group covers managers that plan, direct and coordinate the provision of services and are not classified in Sub-major Group 13: Production and Specialized Services Managers or elsewhere in Sub-major Group 14: Hospitality, Retail and Other Services Managers. For instance, managers of travel agencies, conference centres, contact centres and shopping centres are classified here.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Services Managers Not Elsewhere Classified","lang":"en","source":"isco08"},{"text":"Camp site manager","lang":"en","source":"isco08"},{"text":"Caravan park manager","lang":"en","source":"isco08"},{"text":"Conference centre manager","lang":"en","source":"isco08"},{"text":"Contact centre manager","lang":"en","source":"isco08"},{"text":"Shopping centre manager","lang":"en","source":"isco08"},{"text":"Travel agency manager","lang":"en","source":"isco08"},{"text":"Manager, camp site","lang":"en","source":"isco08"},{"text":"Manager, caravan park","lang":"en","source":"isco08"},{"text":"Manager, conference centre","lang":"en","source":"isco08"},{"text":"Manager, contact centre","lang":"en","source":"isco08"},{"text":"Manager, department: production and operations (travel agency)","lang":"en","source":"isco08"},{"text":"Manager, general: camping site","lang":"en","source":"isco08"},{"text":"Manager, general: caravan park","lang":"en","source":"isco08"},{"text":"Manager, general: travel agency","lang":"en","source":"isco08"},{"text":"Manager, information: tourist","lang":"en","source":"isco08"},{"text":"Manager, shopping centre","lang":"en","source":"isco08"},{"text":"Manager, travel agency","lang":"en","source":"isco08"}]}
