{"source":"isco08","code":"6221","level":4,"parent_code":"622","isco_major":"6","isco_unit":"6221","skill_level":2,"label_en":"Aquaculture Workers","label_hi":null,"description_en":"Aquaculture workers breed and raise fish and cultivate mussels, oysters and other forms of aquatic life, for sale or delivery on a regular basis to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Aquaculture Workers","lang":"en","source":"isco08"},{"text":"Algae cultivator","lang":"en","source":"isco08"},{"text":"Fish farmer","lang":"en","source":"isco08"},{"text":"Oyster farmer","lang":"en","source":"isco08"},{"text":"Pearl cultivator","lang":"en","source":"isco08"},{"text":"Seafood farmer","lang":"en","source":"isco08"},{"text":"Skilled fish farm worker","lang":"en","source":"isco08"},{"text":"Skilled seafood farm worker","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"6222","level":4,"parent_code":"622","isco_major":"6","isco_unit":"6222","skill_level":2,"label_en":"Inland and Coastal Waters Fishery Workers","label_hi":null,"description_en":"Inland and coastal waters fishery workers, alone or as members of fishing-vessel crews, catch fish or gather other forms of aquatic life in inland or coastal waters for sale or delivery on a regular basis to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Inland and Coastal Waters Fishery Workers","lang":"en","source":"isco08"},{"text":"Coastal fishery skipper","lang":"en","source":"isco08"},{"text":"Fisher (coastal waters)","lang":"en","source":"isco08"},{"text":"Fisher (inland waters)","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"6223","level":4,"parent_code":"622","isco_major":"6","isco_unit":"6223","skill_level":2,"label_en":"Deep-sea Fishery Workers","label_hi":null,"description_en":"Deep-sea fishery workers, as skippers or members of fishing vessel crews, catch deep-sea fish for sale or delivery to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Deep-sea Fishery Workers","lang":"en","source":"isco08"},{"text":"Deep sea fisher","lang":"en","source":"isco08"},{"text":"Trawler skipper","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"6224","level":4,"parent_code":"622","isco_major":"6","isco_unit":"6224","skill_level":2,"label_en":"Hunters and Trappers","label_hi":null,"description_en":"Hunters and trappers catch and kill mammals, birds or reptiles mainly for meat, skin, feathers and other products for sale or delivery on a regular basis to wholesale buyers, marketing organizations or at markets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Hunters and Trappers","lang":"en","source":"isco08"},{"text":"Fur trapper","lang":"en","source":"isco08"},{"text":"Seal hunter","lang":"en","source":"isco08"}]}
