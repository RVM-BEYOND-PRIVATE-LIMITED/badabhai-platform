{"source":"isco08","code":"221","level":3,"parent_code":"22","isco_major":"2","isco_unit":null,"skill_level":4,"label_en":"Medical Doctors","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"2211","level":4,"parent_code":"221","isco_major":"2","isco_unit":"2211","skill_level":4,"label_en":"Generalist Medical Practitioners","label_hi":null,"description_en":"Generalist medical practitioners (including family and primary care doctors) diagnose, treat and prevent illness, disease, injury and other physical and mental impairments and maintain general health in humans through application of the principles and procedures of modern medicine. They do not limit their practice to certain disease categories or methods of treatment, and may assume responsibility for the provision of continuing and comprehensive medical care to individuals, families and communities.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Generalist Medical Practitioners","lang":"en","source":"isco08"},{"text":"District medical doctor - therapist","lang":"en","source":"isco08"},{"text":"Family medical practitioner","lang":"en","source":"isco08"},{"text":"General practitioner","lang":"en","source":"isco08"},{"text":"Medical doctor (general)","lang":"en","source":"isco08"},{"text":"Medical officer (general)","lang":"en","source":"isco08"},{"text":"Physician (general)","lang":"en","source":"isco08"},{"text":"Primary health care physician","lang":"en","source":"isco08"},{"text":"Resident medical officer specializing in general practice","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2212","level":4,"parent_code":"221","isco_major":"2","isco_unit":"2212","skill_level":4,"label_en":"Specialist Medical Practitioners","label_hi":null,"description_en":"Specialist medical practitioners (medical doctors) diagnose, treat and prevent illness, disease, injury, and other physical and mental impairments in humans, using specialized testing, diagnostic, medical, surgical, physical and psychiatric techniques, through application of the principles and procedures of modern medicine. They specialize in certain disease categories, types of patient or methods of treatment and may conduct medical education and research in their chosen areas of specialization.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Specialist Medical Practitioners","lang":"en","source":"isco08"},{"text":"Anaesthetist","lang":"en","source":"isco08"},{"text":"Cardiologist","lang":"en","source":"isco08"},{"text":"Emergency medicine specialist","lang":"en","source":"isco08"},{"text":"Gynaecologist","lang":"en","source":"isco08"},{"text":"Obstetrician","lang":"en","source":"isco08"},{"text":"Ophthalmologist","lang":"en","source":"isco08"},{"text":"Paediatrician","lang":"en","source":"isco08"},{"text":"Pathologist","lang":"en","source":"isco08"},{"text":"Preventive medicine specialist","lang":"en","source":"isco08"},{"text":"Psychiatrist","lang":"en","source":"isco08"},{"text":"Radiation oncologist","lang":"en","source":"isco08"},{"text":"Radiologist","lang":"en","source":"isco08"},{"text":"Resident medical officer in specialist training","lang":"en","source":"isco08"},{"text":"Specialist medical practitioner (public health)","lang":"en","source":"isco08"},{"text":"Specialist physician (internal medicine)","lang":"en","source":"isco08"},{"text":"Specialist physician (nuclear medicine)","lang":"en","source":"isco08"},{"text":"Surgeon","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"222","level":3,"parent_code":"22","isco_major":"2","isco_unit":null,"skill_level":4,"label_en":"Nursing and Midwifery Professionals","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"2221","level":4,"parent_code":"222","isco_major":"2","isco_unit":"2221","skill_level":4,"label_en":"Nursing Professionals","label_hi":null,"description_en":"Nursing professionals provide treatment, support and care services for people who are in need of nursing care due to the effects of ageing, injury, illness or other physical or mental impairment, or potential risks to health. They assume responsibility for the planning and management of the care of patients, including the supervision of other health care workers, working autonomously or in teams with medical doctors and others in the practical application of preventive and curative measures.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Nursing Professionals","lang":"en","source":"isco08"},{"text":"Clinical nurse consultant","lang":"en","source":"isco08"},{"text":"District nurse","lang":"en","source":"isco08"},{"text":"Nurse anaesthetist","lang":"en","source":"isco08"},{"text":"Nurse educator","lang":"en","source":"isco08"},{"text":"Nurse practitioner","lang":"en","source":"isco08"},{"text":"Operating theatre nurse","lang":"en","source":"isco08"},{"text":"Professional nurse","lang":"en","source":"isco08"},{"text":"Public health nurse","lang":"en","source":"isco08"},{"text":"Specialist nurse","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2222","level":4,"parent_code":"222","isco_major":"2","isco_unit":"2222","skill_level":4,"label_en":"Midwifery Professionals","label_hi":null,"description_en":"Midwifery professionals plan, manage, provide and evaluate midwifery care services before, during and after pregnancy and childbirth. They provide delivery care for reducing health risks to women and newborn children, working autonomously or in teams with other health care providers.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Midwifery Professionals","lang":"en","source":"isco08"},{"text":"Professional midwife","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"223","level":3,"parent_code":"22","isco_major":"2","isco_unit":null,"skill_level":4,"label_en":"Traditional and Complementary Medicine Professionals","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"2230","level":4,"parent_code":"223","isco_major":"2","isco_unit":"2230","skill_level":4,"label_en":"Traditional and Complementary Medicine Professionals","label_hi":null,"description_en":"Traditional and complementary medicine professionals examine patients, prevent and treat illness, disease, injury, and other physical and mental impairments and maintain general health in humans by applying knowledge, skills and practices acquired through extensive study of the theories, beliefs and experiences, originating in specific cultures","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Traditional and Complementary Medicine Professionals","lang":"en","source":"isco08"},{"text":"Acupuncturist","lang":"en","source":"isco08"},{"text":"Ayurvedic practitioner","lang":"en","source":"isco08"},{"text":"Chinese herbal medicine practitioner","lang":"en","source":"isco08"},{"text":"Homeopath","lang":"en","source":"isco08"},{"text":"Naturopath","lang":"en","source":"isco08"},{"text":"Unani practitioner","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"224","level":3,"parent_code":"22","isco_major":"2","isco_unit":null,"skill_level":4,"label_en":"Paramedical Practitioners","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"2240","level":4,"parent_code":"224","isco_major":"2","isco_unit":"2240","skill_level":4,"label_en":"Paramedical Practitioners","label_hi":null,"description_en":"Paramedical practitioners provide advisory, diagnostic, curative and preventive medical services more limited in scope and complexity than those carried out by medical doctors. They work autonomously, or with limited supervision of medical doctors, and apply advanced clinical procedures for treating and preventing diseases, injuries and other physical or mental impairments common to specific communities.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Paramedical Practitioners","lang":"en","source":"isco08"},{"text":"Advanced care paramedic","lang":"en","source":"isco08"},{"text":"Clinical officer (paramedical)","lang":"en","source":"isco08"},{"text":"Feldscher","lang":"en","source":"isco08"},{"text":"Primary care paramedic","lang":"en","source":"isco08"},{"text":"Surgical technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"225","level":3,"parent_code":"22","isco_major":"2","isco_unit":null,"skill_level":4,"label_en":"Veterinarians","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"2250","level":4,"parent_code":"225","isco_major":"2","isco_unit":"2250","skill_level":4,"label_en":"Veterinarians","label_hi":null,"description_en":"Veterinarians diagnose, prevent and treat diseases, injuries and dysfunctions of animals. They may provide care to a wide range of animals or specialize in the treatment of a particular animal group or in a particular specialty area, or provide professional services to commercial firms producing biological and pharmaceutical products.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Veterinarians","lang":"en","source":"isco08"},{"text":"Animal pathologist","lang":"en","source":"isco08"},{"text":"Veterinarian","lang":"en","source":"isco08"},{"text":"Veterinary epidemiologist","lang":"en","source":"isco08"},{"text":"Veterinary intern","lang":"en","source":"isco08"},{"text":"Veterinary surgeon","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"226","level":3,"parent_code":"22","isco_major":"2","isco_unit":null,"skill_level":4,"label_en":"Other Health Professionals","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"2261","level":4,"parent_code":"226","isco_major":"2","isco_unit":"2261","skill_level":4,"label_en":"Dentists","label_hi":null,"description_en":"Dentists diagnose, treat and prevent diseases, injuries and abnormalities of the teeth, mouth, jaws and associated tissues by applying the principles and procedures of modern dentistry. They use a broad range of specialized diagnostic, surgical and other techniques to promote and restore oral health.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Dentists","lang":"en","source":"isco08"},{"text":"Dental Practitioner","lang":"en","source":"isco08"},{"text":"Dental surgeon","lang":"en","source":"isco08"},{"text":"Dentist","lang":"en","source":"isco08"},{"text":"Endodontist","lang":"en","source":"isco08"},{"text":"Oral and Maxillofacial Surgeon","lang":"en","source":"isco08"},{"text":"Oral Pathologist","lang":"en","source":"isco08"},{"text":"Orthodontist","lang":"en","source":"isco08"},{"text":"Paedodontist","lang":"en","source":"isco08"},{"text":"Periodontist","lang":"en","source":"isco08"},{"text":"Prosthodontist","lang":"en","source":"isco08"},{"text":"Stomatologist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2262","level":4,"parent_code":"226","isco_major":"2","isco_unit":"2262","skill_level":4,"label_en":"Pharmacists","label_hi":null,"description_en":"Pharmacists store, preserve, compound, and dispense medicinal products and counsel on the proper use and adverse effects of drugs and medicines following prescriptions issued by medical doctors and other health professionals. They contribute to researching, testing, preparing, prescribing and monitoring medicinal therapies for optimizing human health.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Pharmacists","lang":"en","source":"isco08"},{"text":"Dispensing chemist","lang":"en","source":"isco08"},{"text":"Hospital pharmacist","lang":"en","source":"isco08"},{"text":"Industrial pharmacist","lang":"en","source":"isco08"},{"text":"Retail pharmacist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2263","level":4,"parent_code":"226","isco_major":"2","isco_unit":"2263","skill_level":4,"label_en":"Environmental and Occupational Health and Hygiene Professionals","label_hi":null,"description_en":"Environmental and occupational health and hygiene professionals assess, plan and implement programmes to recognize, monitor and control environmental factors that can potentially affect human health, to ensure safe and healthy working conditions and to prevent disease or injury caused by chemical, physical, radiological and biological agents or ergonomic factors.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Environmental and Occupational Health and Hygiene Professionals","lang":"en","source":"isco08"},{"text":"Environmental health officer","lang":"en","source":"isco08"},{"text":"Occupational health and safety adviser","lang":"en","source":"isco08"},{"text":"Occupational hygienist","lang":"en","source":"isco08"},{"text":"Radiation protection expert","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2264","level":4,"parent_code":"226","isco_major":"2","isco_unit":"2264","skill_level":4,"label_en":"Physiotherapists","label_hi":null,"description_en":"Physiotherapists assess, plan and implement rehabilitative programmes that improve or restore human motor functions, maximize movement ability, relieve pain syndromes, and treat or prevent physical challenges associated with injuries, diseases and other impairments. They apply a broad range of physical therapies and techniques such as movement, ultrasound, heating, laser and other techniques.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Physiotherapists","lang":"en","source":"isco08"},{"text":"Geriatric physical therapist","lang":"en","source":"isco08"},{"text":"Manipulative therapist","lang":"en","source":"isco08"},{"text":"Orthopaedic physical therapist","lang":"en","source":"isco08"},{"text":"Paediatric physical therapist","lang":"en","source":"isco08"},{"text":"Physical therapist","lang":"en","source":"isco08"},{"text":"Physiotherapist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2265","level":4,"parent_code":"226","isco_major":"2","isco_unit":"2265","skill_level":4,"label_en":"Dieticians and Nutritionists","label_hi":null,"description_en":"Dieticians and nutritionists assess, plan and implement programmes to enhance the impact of food and nutrition on human health.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Dieticians and Nutritionists","lang":"en","source":"isco08"},{"text":"Clinical dietician","lang":"en","source":"isco08"},{"text":"Food service dietician","lang":"en","source":"isco08"},{"text":"Nutritionist","lang":"en","source":"isco08"},{"text":"Public health nutritionist","lang":"en","source":"isco08"},{"text":"Sports nutritionist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2266","level":4,"parent_code":"226","isco_major":"2","isco_unit":"2266","skill_level":4,"label_en":"Audiologists and Speech Therapists","label_hi":null,"description_en":"Audiologists and speech therapists evaluate, manage and treat physical disorders affecting human hearing, speech, communication and swallowing. They prescribe corrective devices or rehabilitative therapies for hearing loss, speech disorders, and related sensory and neural problems and provide counselling on hearing safety and communication performance.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Audiologists and Speech Therapists","lang":"en","source":"isco08"},{"text":"Audiologist","lang":"en","source":"isco08"},{"text":"Language therapist","lang":"en","source":"isco08"},{"text":"Speech pathologist","lang":"en","source":"isco08"},{"text":"Speech therapist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2267","level":4,"parent_code":"226","isco_major":"2","isco_unit":"2267","skill_level":4,"label_en":"Optometrists and Ophthalmic Opticians","label_hi":null,"description_en":"Optometrists and ophthalmic opticians provide diagnosis, management and treatment services for disorders of the eyes and visual system. They counsel on eye care and prescribe optical aids or other therapies for visual disturbance.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Optometrists and Ophthalmic Opticians","lang":"en","source":"isco08"},{"text":"Ophthalmic optician","lang":"en","source":"isco08"},{"text":"Optometrist","lang":"en","source":"isco08"},{"text":"Orthoptist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2269","level":4,"parent_code":"226","isco_major":"2","isco_unit":"2269","skill_level":4,"label_en":"Health Professionals Not Elsewhere Classified","label_hi":null,"description_en":"This unit group covers health professionals not classified elsewhere in Sub-major Group 22: Health Professionals. For instance, the group includes occupations such as podiatrist, occupational therapist, recreational therapist, chiropractor, osteopath and other professionals providing diagnostic, preventive, curative and rehabilitative health services.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Health Professionals Not Elsewhere Classified","lang":"en","source":"isco08"},{"text":"Arts therapist","lang":"en","source":"isco08"},{"text":"Chiropractor","lang":"en","source":"isco08"},{"text":"Dance and movement therapist","lang":"en","source":"isco08"},{"text":"Occupational therapist","lang":"en","source":"isco08"},{"text":"Osteopath","lang":"en","source":"isco08"},{"text":"Podiatrist","lang":"en","source":"isco08"},{"text":"Recreational therapist","lang":"en","source":"isco08"}]}
