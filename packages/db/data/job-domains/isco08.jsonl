{"source":"isco08","code":"3141","level":4,"parent_code":"314","isco_major":"3","isco_unit":"3141","skill_level":3,"label_en":"Life Science Technicians (excluding Medical)","label_hi":null,"description_en":"Life science technicians (excluding medical) provide technical support to life science professionals undertaking research, analysis and testing of living organisms, and development and application of products and processes resulting from research in areas such as natural resource management, environmental protection, plant and animal biology, microbiology, and cell and molecular biology.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Life Science Technicians (excluding Medical)","lang":"en","source":"isco08"},{"text":"Bacteriology technician","lang":"en","source":"isco08"},{"text":"Biochemistry technician","lang":"en","source":"isco08"},{"text":"Herbarium technician","lang":"en","source":"isco08"},{"text":"Pharmacology technician","lang":"en","source":"isco08"},{"text":"Serology technician","lang":"en","source":"isco08"},{"text":"Tissue culture technician","lang":"en","source":"isco08"},{"text":"Zoology technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3142","level":4,"parent_code":"314","isco_major":"3","isco_unit":"3142","skill_level":3,"label_en":"Agricultural Technicians","label_hi":null,"description_en":"Agricultural technicians perform tests and experiments, and provide technical and scientific support to agricultural scientists, farmers and farm managers.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Agricultural Technicians","lang":"en","source":"isco08"},{"text":"Dairy Technician","lang":"en","source":"isco08"},{"text":"Field Crop Technician","lang":"en","source":"isco08"},{"text":"Herd Tester","lang":"en","source":"isco08"},{"text":"Horticultural Technician","lang":"en","source":"isco08"},{"text":"Poultry Technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3143","level":4,"parent_code":"314","isco_major":"3","isco_unit":"3143","skill_level":3,"label_en":"Forestry Technicians","label_hi":null,"description_en":"Forestry technicians perform technical and supervisory functions in support of forestry research and forest management, harvesting, resource conservation and environmental protection.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Forestry Technicians","lang":"en","source":"isco08"},{"text":"Forestry technician","lang":"en","source":"isco08"},{"text":"Silviculture technician","lang":"en","source":"isco08"}]}
