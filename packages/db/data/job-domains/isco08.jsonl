{"source":"isco08","code":"2342","level":4,"parent_code":"234","isco_major":"2","isco_unit":"2342","skill_level":4,"label_en":"Early Childhood Educators","label_hi":null,"description_en":"Early childhood educators promote the social, physical, and intellectual development of children below primary school age through the provision of educational and play activities","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Early Childhood Educators","lang":"en","source":"isco08"},{"text":"Early childhood educator","lang":"en","source":"isco08"},{"text":"Pre-school teacher","lang":"en","source":"isco08"}]}
