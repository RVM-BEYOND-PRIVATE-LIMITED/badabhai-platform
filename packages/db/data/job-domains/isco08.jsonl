{"source":"isco08","code":"2330","level":4,"parent_code":"233","isco_major":"2","isco_unit":"2330","skill_level":4,"label_en":"Secondary Education Teachers","label_hi":null,"description_en":"Secondary education teachers teach one or more subjects at secondary education level, excluding subjects intended to prepare students for employment in specific occupational areas.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Secondary Education Teachers","lang":"en","source":"isco08"},{"text":"High school teacher","lang":"en","source":"isco08"},{"text":"Secondary education teacher","lang":"en","source":"isco08"}]}
