{"source":"isco08","code":"2161","level":4,"parent_code":"216","isco_major":"2","isco_unit":"2161","skill_level":4,"label_en":"Building Architects","label_hi":null,"description_en":"Building architects design commercial, industrial, institutional, residential and recreational buildings and plan and monitor their construction, maintenance and rehabilitation.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Building Architects","lang":"en","source":"isco08"},{"text":"Building architect","lang":"en","source":"isco08"},{"text":"Interior architect","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2162","level":4,"parent_code":"216","isco_major":"2","isco_unit":"2162","skill_level":4,"label_en":"Landscape Architects","label_hi":null,"description_en":"Landscape architects plan and design landscapes and open spaces for projects such as, parks, schools, institutions, roads, external areas for commercial, industrial and residential sites, and plan and monitor their construction, maintenance and rehabilitation.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Landscape Architects","lang":"en","source":"isco08"},{"text":"Landscape architect","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2163","level":4,"parent_code":"216","isco_major":"2","isco_unit":"2163","skill_level":4,"label_en":"Product and Garment Designers","label_hi":null,"description_en":"Product and garment designers design and develop products for manufacture and prepare designs and specifications of products for mass, batch and one-off production.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Product and Garment Designers","lang":"en","source":"isco08"},{"text":"Costume designer","lang":"en","source":"isco08"},{"text":"Fashion designer","lang":"en","source":"isco08"},{"text":"Industrial designer","lang":"en","source":"isco08"},{"text":"Jewellery designer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2164","level":4,"parent_code":"216","isco_major":"2","isco_unit":"2164","skill_level":4,"label_en":"Town and Traffic Planners","label_hi":null,"description_en":"Town and traffic planners develop and implement plans and policies for the controlled use of urban and rural land and for traffic systems. They conduct research and provide advice on economic, environmental and social factors affecting land use and traffic flows.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Town and Traffic Planners","lang":"en","source":"isco08"},{"text":"Land Planner","lang":"en","source":"isco08"},{"text":"Traffic planner","lang":"en","source":"isco08"},{"text":"Urban Planner","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2165","level":4,"parent_code":"216","isco_major":"2","isco_unit":"2165","skill_level":4,"label_en":"Cartographers and Surveyors","label_hi":null,"description_en":"Cartographers and surveyors determine the exact position of, or prepare and revise digital, graphic and pictorial maps, charts or other visual representation of, natural and constructed features and boundaries of land, seas, underground areas and celestial bodies, applying scientific and mathematical principles.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Cartographers and Surveyors","lang":"en","source":"isco08"},{"text":"Aerial surveyor","lang":"en","source":"isco08"},{"text":"Cadastral surveyor","lang":"en","source":"isco08"},{"text":"Cartographer","lang":"en","source":"isco08"},{"text":"Hydrographic surveyor","lang":"en","source":"isco08"},{"text":"Land surveyor","lang":"en","source":"isco08"},{"text":"Mine surveyor","lang":"en","source":"isco08"},{"text":"Photogrammetrist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2166","level":4,"parent_code":"216","isco_major":"2","isco_unit":"2166","skill_level":4,"label_en":"Graphic and Multimedia Designers","label_hi":null,"description_en":"Graphic and multimedia designers design visual and audio-visual content for the communication of information using print, film, electronic, digital and other forms of visual and audio media. They create graphics, special effects, animation or other visual images for use in computer games, movies, music videos, print media and advertisements.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Graphic and Multimedia Designers","lang":"en","source":"isco08"},{"text":"Animator","lang":"en","source":"isco08"},{"text":"Commercial artists","lang":"en","source":"isco08"},{"text":"Computer games designer","lang":"en","source":"isco08"},{"text":"Digital artist","lang":"en","source":"isco08"},{"text":"Graphic designer","lang":"en","source":"isco08"},{"text":"Illustrator","lang":"en","source":"isco08"},{"text":"Multimedia designer","lang":"en","source":"isco08"},{"text":"Publication designer","lang":"en","source":"isco08"},{"text":"Web designer","lang":"en","source":"isco08"}]}
