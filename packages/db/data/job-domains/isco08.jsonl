{"source":"isco08","code":"6310","level":4,"parent_code":"631","isco_major":"6","isco_unit":"6310","skill_level":2,"label_en":"Subsistence Crop Farmers","label_hi":null,"description_en":"Subsistence crop farmers grow and harvest field or tree and shrub crops, vegetables and fruit, in order to provide food, shelter and, in some cases, a minimum of cash income for themselves and their households.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Subsistence Crop Farmers","lang":"en","source":"isco08"},{"text":"Subsistence crop farmer","lang":"en","source":"isco08"},{"text":"Subsistence gardener","lang":"en","source":"isco08"},{"text":"Subsistence vegetable grower","lang":"en","source":"isco08"}]}
