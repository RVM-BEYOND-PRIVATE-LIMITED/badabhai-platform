{"source":"isco08","code":"2351","level":4,"parent_code":"235","isco_major":"2","isco_unit":"2351","skill_level":4,"label_en":"Education Methods Specialists","label_hi":null,"description_en":"Education methods specialists conduct research and develop or advise on teaching methods, courses and aids. They review and examine teachers' work, the functioning of educational institutions and the results achieved and recommend changes and improvements.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Education Methods Specialists","lang":"en","source":"isco08"},{"text":"Curriculum coordinator","lang":"en","source":"isco08"},{"text":"Curriculum developer","lang":"en","source":"isco08"},{"text":"Education methods specialist","lang":"en","source":"isco08"},{"text":"Schools inspector","lang":"en","source":"isco08"},{"text":"Teaching aids specialist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2352","level":4,"parent_code":"235","isco_major":"2","isco_unit":"2352","skill_level":4,"label_en":"Special Needs Teachers","label_hi":null,"description_en":"Special needs teachers teach physically or mentally handicapped children, young persons, or adults, or those with learning difficulties or other special needs. They promote the social, emotional, intellectual and physical development of their students.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Special Needs Teachers","lang":"en","source":"isco08"},{"text":"Learning disabilities special education teacher","lang":"en","source":"isco08"},{"text":"Learning support teacher","lang":"en","source":"isco08"},{"text":"Remedial teacher","lang":"en","source":"isco08"},{"text":"Teacher of gifted children","lang":"en","source":"isco08"},{"text":"Teacher of the hearing impaired","lang":"en","source":"isco08"},{"text":"Teacher of the sight impaired","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2353","level":4,"parent_code":"235","isco_major":"2","isco_unit":"2353","skill_level":4,"label_en":"Other Language Teachers","label_hi":null,"description_en":"Other language teachers teach non-native languages to adults and children who are learning a language for reasons of migration, to fulfil employment requirements or opportunities, to facilitate participation in educational programmes delivered in a foreign language, or for personal enrichment. They work outside the mainstream primary, secondary and higher education systems, or in support of students and teachers within those systems.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Other Language Teachers","lang":"en","source":"isco08"},{"text":"Intensive language teacher","lang":"en","source":"isco08"},{"text":"Migrant education teacher","lang":"en","source":"isco08"},{"text":"Practical language teacher","lang":"en","source":"isco08"},{"text":"Second language teacher","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2354","level":4,"parent_code":"235","isco_major":"2","isco_unit":"2354","skill_level":4,"label_en":"Other Music Teachers","label_hi":null,"description_en":"Other music teachers teach students in the practice, theory and performance of music outside the mainstream primary, secondary and higher education systems, but may provide private or small group tuition as an extra curricular activity in association with mainstream educational institutions.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Other Music Teachers","lang":"en","source":"isco08"},{"text":"Guitar teacher (private tuition)","lang":"en","source":"isco08"},{"text":"Piano teacher (private tuition)","lang":"en","source":"isco08"},{"text":"Singing teacher (private tuition)","lang":"en","source":"isco08"},{"text":"Violin teacher (private tuition)","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2355","level":4,"parent_code":"235","isco_major":"2","isco_unit":"2355","skill_level":4,"label_en":"Other Arts Teachers","label_hi":null,"description_en":"Other arts teachers teach students in the practice, theory and performance of dance, drama, visual and other arts (excluding music) outside the mainstream primary, secondary and higher education systems, but may provide private or small group tuition as an extracurricular activity in association with mainstream educational institutions.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Other Arts Teachers","lang":"en","source":"isco08"},{"text":"Dance teacher (private tuition)","lang":"en","source":"isco08"},{"text":"Drama teacher (private tuition)","lang":"en","source":"isco08"},{"text":"Painting teacher (private tuition)","lang":"en","source":"isco08"},{"text":"Sculpture teacher (private tuition)","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2356","level":4,"parent_code":"235","isco_major":"2","isco_unit":"2356","skill_level":4,"label_en":"Information Technology Trainers","label_hi":null,"description_en":"Information technology trainers develop, schedule and conduct training programmes and courses for computer and other information technology users outside the mainstream primary, secondary and higher education systems.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Information Technology Trainers","lang":"en","source":"isco08"},{"text":"Computer trainer","lang":"en","source":"isco08"},{"text":"Software trainer","lang":"en","source":"isco08"}]}
