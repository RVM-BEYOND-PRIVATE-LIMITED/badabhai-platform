{"source":"isco08","code":"2656","level":4,"parent_code":"265","isco_major":"2","isco_unit":"2656","skill_level":4,"label_en":"Announcers on Radio, Television and Other Media","label_hi":null,"description_en":"Announcers on radio, television and other media read news bulletins, conduct interviews, and make other announcements or introductions on radio, television, and in theatres and other establishments or media","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Announcers on Radio, Television and Other Media","lang":"en","source":"isco08"},{"text":"News anchor","lang":"en","source":"isco08"},{"text":"Radio announcer","lang":"en","source":"isco08"},{"text":"Sports announcer","lang":"en","source":"isco08"},{"text":"Talk show host/hostess","lang":"en","source":"isco08"},{"text":"Television announcer","lang":"en","source":"isco08"},{"text":"Traffic reporter","lang":"en","source":"isco08"},{"text":"Weather reporter","lang":"en","source":"isco08"}]}
