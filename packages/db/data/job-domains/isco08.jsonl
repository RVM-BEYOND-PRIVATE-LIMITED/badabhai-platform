{"source":"isco08","code":"2111","level":4,"parent_code":"211","isco_major":"2","isco_unit":"2111","skill_level":4,"label_en":"Physicists and Astronomers","label_hi":null,"description_en":"Physicists and astronomers conduct research and improve or develop concepts, theories and operational methods concerning matter, space, time, energy, forces and fields and the interrelationship between these physical phenomena. They apply scientific knowledge relating to physics and astronomy in industrial, medical, military or other fields.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Physicists and Astronomers","lang":"en","source":"isco08"},{"text":"Astronomer","lang":"en","source":"isco08"},{"text":"Medical Physicist","lang":"en","source":"isco08"},{"text":"Nuclear Physicist","lang":"en","source":"isco08"},{"text":"Physicist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2112","level":4,"parent_code":"211","isco_major":"2","isco_unit":"2112","skill_level":4,"label_en":"Meteorologists","label_hi":null,"description_en":"Meteorologists prepare short-term or long-term weather forecasts used in aviation, shipping, agriculture and other areas and for the information of the general public. They conduct research related to the composition, structure and dynamics of the atmosphere.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Meteorologists","lang":"en","source":"isco08"},{"text":"Climatologist","lang":"en","source":"isco08"},{"text":"Hydrometeorologist","lang":"en","source":"isco08"},{"text":"Meteorologist","lang":"en","source":"isco08"},{"text":"Weather forecaster","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2113","level":4,"parent_code":"211","isco_major":"2","isco_unit":"2113","skill_level":4,"label_en":"Chemists","label_hi":null,"description_en":"Chemists conduct research, improve or develop concepts, theories and operational methods, or apply scientific knowledge relating to chemistry, to develop new knowledge or products and for quality and process control.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Chemists","lang":"en","source":"isco08"},{"text":"Chemist","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"2114","level":4,"parent_code":"211","isco_major":"2","isco_unit":"2114","skill_level":4,"label_en":"Geologists and geophysicists","label_hi":null,"description_en":"Geologists and geophysicists conduct research; improve or develop concepts, theories and operational methods, or apply scientific knowledge relating to geology and geophysics in such fields as oil, gas and mineral exploration and extraction, water conservation, civil engineering, telecommunications and navigation, and assessment and mitigation of the effects of development and waste disposal projects on the environment.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Geologists and geophysicists","lang":"en","source":"isco08"},{"text":"Geological oceanographer","lang":"en","source":"isco08"},{"text":"Geologist","lang":"en","source":"isco08"},{"text":"Geophysical oceanographer","lang":"en","source":"isco08"},{"text":"Geophysicist","lang":"en","source":"isco08"},{"text":"Geoscientist","lang":"en","source":"isco08"}]}
