{"source":"isco08","code":"3131","level":4,"parent_code":"313","isco_major":"3","isco_unit":"3131","skill_level":3,"label_en":"Power Production Plant Operators","label_hi":null,"description_en":"Power production plant operators operate, monitor and maintain switchboards and related equipment in electrical control centres which control the production and distribution of electrical or other power in transmission networks. The equipment operated includes reactors, turbines, generators and other auxiliary equipment in electrical power generating stations.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Power Production Plant Operators","lang":"en","source":"isco08"},{"text":"Distribution control operator","lang":"en","source":"isco08"},{"text":"Electric power plant operator","lang":"en","source":"isco08"},{"text":"Generating station operator","lang":"en","source":"isco08"},{"text":"Hydroelectric power plant operator","lang":"en","source":"isco08"},{"text":"Nuclear power plant operator","lang":"en","source":"isco08"},{"text":"Solar power plant operator","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3132","level":4,"parent_code":"313","isco_major":"3","isco_unit":"3132","skill_level":3,"label_en":"Incinerator and Water Treatment Plant Operators","label_hi":null,"description_en":"Incinerator and water treatment plant operators monitor and operate computerized control systems and related equipment in solid and liquid waste treatment plants to regulate the treatment and disposal of sewage and wastes, and in water filtration and treatment plants to regulate the treatment and distribution of water.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Incinerator and Water Treatment Plant Operators","lang":"en","source":"isco08"},{"text":"Incinerator operator","lang":"en","source":"isco08"},{"text":"Liquid waste process operator","lang":"en","source":"isco08"},{"text":"Pumping-station operator","lang":"en","source":"isco08"},{"text":"Sewage plant operator","lang":"en","source":"isco08"},{"text":"Wastewater operator","lang":"en","source":"isco08"},{"text":"Water treatment plant operator","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3133","level":4,"parent_code":"313","isco_major":"3","isco_unit":"3133","skill_level":3,"label_en":"Chemical Processing Plant Controllers","label_hi":null,"description_en":"Chemical processing plant controllers operate and monitor chemical plants and related multi-function process control machinery, and adjust and maintain processing units and equipment which distil, filter, separate, heat or refine chemicals.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Chemical Processing Plant Controllers","lang":"en","source":"isco08"},{"text":"Chemical filtering and separating equipment operator","lang":"en","source":"isco08"},{"text":"Chemical heat treating plant operator","lang":"en","source":"isco08"},{"text":"Chemical process technician","lang":"en","source":"isco08"},{"text":"Chemical still and reactor operator","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3134","level":4,"parent_code":"313","isco_major":"3","isco_unit":"3134","skill_level":3,"label_en":"Petroleum and Natural Gas Refining Plant Operators","label_hi":null,"description_en":"Petroleum and natural gas refining plant operators operate and monitor plants and adjust and maintain processing units and equipment which refine, distil and treat petroleum, petroleum-based products and by-products, or natural gas.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Petroleum and Natural Gas Refining Plant Operators","lang":"en","source":"isco08"},{"text":"Blender operator (petroleum and natural gas refining)","lang":"en","source":"isco08"},{"text":"Gas plant operator","lang":"en","source":"isco08"},{"text":"Paraffin plant operator","lang":"en","source":"isco08"},{"text":"Petroleum process operator","lang":"en","source":"isco08"},{"text":"Refinery process technician","lang":"en","source":"isco08"},{"text":"Still operator (still petroleum and natural gas refining)","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3135","level":4,"parent_code":"313","isco_major":"3","isco_unit":"3135","skill_level":3,"label_en":"Metal Production Process Controllers","label_hi":null,"description_en":"Metal production process controllers operate and monitor multi-function process control machinery and equipment to control the processing of metal converting and refining furnaces, metal-rolling mills, metal heat-treating or metal-extrusion plant.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Metal Production Process Controllers","lang":"en","source":"isco08"},{"text":"Blast furnace operator","lang":"en","source":"isco08"},{"text":"Central control caster","lang":"en","source":"isco08"},{"text":"Rolling mill control operator","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3139","level":4,"parent_code":"313","isco_major":"3","isco_unit":"3139","skill_level":3,"label_en":"Process Control Technicians Not Elsewhere Classified","label_hi":null,"description_en":"This unit group covers process control technicians not classified elsewhere in Minor Group 313: Process Control Technicians. For instance, the unit group includes those who operate multiple process control equipment in manufacturing assembly lines and paper and pulp production.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Process Control Technicians Not Elsewhere Classified","lang":"en","source":"isco08"},{"text":"Automated assembly line operator","lang":"en","source":"isco08"},{"text":"Industrial robot controller","lang":"en","source":"isco08"},{"text":"Panel board operator (pulp and paper)","lang":"en","source":"isco08"},{"text":"Paper pulp refinery operator","lang":"en","source":"isco08"},{"text":"Pulping control operator","lang":"en","source":"isco08"},{"text":"Pulping technician","lang":"en","source":"isco08"}]}
