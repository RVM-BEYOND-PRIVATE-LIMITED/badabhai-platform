{"source":"isco08","code":"7111","level":4,"parent_code":"711","isco_major":"7","isco_unit":"7111","skill_level":2,"label_en":"House Builders","label_hi":null,"description_en":"House builders erect, maintain and repair houses and similar small buildings using either traditional or modern techniques and materials.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"House Builders","lang":"en","source":"isco08"},{"text":"House builder","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"7112","level":4,"parent_code":"711","isco_major":"7","isco_unit":"7112","skill_level":2,"label_en":"Bricklayers and Related Workers","label_hi":null,"description_en":"Bricklayers and related workers lay bricks, pre-cut stones and other types of building blocks in mortar to construct and repair walls, partitions, arches and other structures.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Bricklayers and Related Workers","lang":"en","source":"isco08"},{"text":"Block layer","lang":"en","source":"isco08"},{"text":"Bricklayer","lang":"en","source":"isco08"},{"text":"Chimney builder","lang":"en","source":"isco08"},{"text":"Refractory bricklayer","lang":"en","source":"isco08"}]}
