{"source":"isco08","code":"1112","level":4,"parent_code":"111","isco_major":"1","isco_unit":"1112","skill_level":null,"label_en":"Senior Government Officials","label_hi":null,"description_en":"Senior government officials advise governments on policy matters, oversee the interpretation and implementation of government policies and legislation by government departments and agencies, represent their country abroad and act on its behalf, or carry out similar tasks in intergovernmental organizations. They plan, organize, direct, control and evaluate the overall activities of municipal or local, regional and national government departments, boards, agencies or commissions in accordance with legislation and policies established by government and legislative bodies.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Senior Government Officials","lang":"en","source":"isco08"},{"text":"Ambassador","lang":"en","source":"isco08"},{"text":"City administrator","lang":"en","source":"isco08"},{"text":"Civil service commissioner","lang":"en","source":"isco08"},{"text":"Consul-general","lang":"en","source":"isco08"},{"text":"Director-general (government department)","lang":"en","source":"isco08"},{"text":"Director-general (intergovernmental organization)","lang":"en","source":"isco08"},{"text":"Fire commissioner","lang":"en","source":"isco08"},{"text":"Inspector-general (police)","lang":"en","source":"isco08"},{"text":"Permanent head (government department)","lang":"en","source":"isco08"},{"text":"Police chief constable","lang":"en","source":"isco08"},{"text":"Police commissioner","lang":"en","source":"isco08"},{"text":"Secretary-General (government administration)","lang":"en","source":"isco08"},{"text":"Under-secretary (government)","lang":"en","source":"isco08"},{"text":"Administrator, city","lang":"en","source":"isco08"},{"text":"Administrator, government","lang":"en","source":"isco08"},{"text":"Administrator, intergovernmental organization","lang"