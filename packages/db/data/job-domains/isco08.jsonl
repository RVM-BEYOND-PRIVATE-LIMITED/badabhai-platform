{"source":"isco08","code":"2310","level":4,"parent_code":"231","isco_major":"2","isco_unit":"2310","skill_level":4,"label_en":"University and Higher Education Teachers","label_hi":null,"description_en":"University and higher education teachers prepare and deliver lectures and conduct tutorials in one or more subjects within a prescribed course of study at a university or other higher educational institution. They conduct research, and prepare scholarly papers and books.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"University and Higher Education Teachers","lang":"en","source":"isco08"},{"text":"Higher education lecturer","lang":"en","source":"isco08"},{"text":"Professor","lang":"en","source":"isco08"},{"text":"University lecturer","lang":"en","source":"isco08"},{"text":"University tutor","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"232","level":3,"parent_code":"23","isco_major":"2","isco_unit":null,"skill_level":4,"label_en":"Vocational education teachers","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"2320","level":4,"parent_code":"232","isco_major":"2","isco_unit":"2320","skill_level":4,"label_en":"Vocational Education Teachers","label_hi":null,"description_en":"Vocational education teachers teach or instruct vocational or occupational subjects in adult and further education institutions and to senior students in secondary schools and colleges. They prepare students for employment in specific occupations or occupational areas for which university or higher education is not normally required.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Vocational Education Teachers","lang":"en","source":"isco08"},{"text":"Automotive technology instructor","lang":"en","source":"isco08"},{"text":"Cosmetology instructor","lang":"en","source":"isco08"},{"text":"Vocational education teacher","lang":"en","source":"isco08"}]}
