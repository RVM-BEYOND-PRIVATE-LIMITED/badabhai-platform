{"source":"isco08","code":"2120","level":4,"parent_code":"212","isco_major":"2","isco_unit":"2120","skill_level":4,"label_en":"Mathematicians, Actuaries and Statisticians","label_hi":null,"description_en":"Mathematicians, actuaries and statisticians conduct research and improve or develop mathematical, actuarial and statistical concepts, theories and operational methods and techniques and advise on or engage in their practical application in such fields as engineering, business and social and other sciences.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Mathematicians, Actuaries and Statisticians","lang":"en","source":"isco08"},{"text":"Actuary","lang":"en","source":"isco08"},{"text":"Demographer","lang":"en","source":"isco08"},{"text":"Mathematician","lang":"en","source":"isco08"},{"text":"Operations research analyst","lang":"en","source":"isco08"},{"text":"Statistician","lang":"en","source":"isco08"}]}
