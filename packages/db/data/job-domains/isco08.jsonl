{"source":"isco08","code":"3111","level":4,"parent_code":"311","isco_major":"3","isco_unit":"3111","skill_level":3,"label_en":"Chemical and Physical Science Technicians","label_hi":null,"description_en":"Chemical and physical science technicians perform technical tasks to aid in research in chemistry, physics, geology, geophysics, meteorology and astronomy, and in the development of industrial, medical, military and other practical applications of research results.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Chemical and Physical Science Technicians","lang":"en","source":"isco08"},{"text":"Chemistry technician","lang":"en","source":"isco08"},{"text":"Geology technician","lang":"en","source":"isco08"},{"text":"Meteorology technician","lang":"en","source":"isco08"},{"text":"Physics technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3112","level":4,"parent_code":"311","isco_major":"3","isco_unit":"3112","skill_level":3,"label_en":"Civil Engineering Technicians","label_hi":null,"description_en":"Civil engineering technicians perform technical tasks in civil engineering research and in the design, construction, operation, maintenance and repair of buildings and other structures such as water supply and wastewater treatment systems, bridges, roads, dams and airports.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Civil Engineering Technicians","lang":"en","source":"isco08"},{"text":"Building inspector","lang":"en","source":"isco08"},{"text":"Building surveyor","lang":"en","source":"isco08"},{"text":"Civil engineering technician","lang":"en","source":"isco08"},{"text":"Clerk of Works","lang":"en","source":"isco08"},{"text":"Fire inspector","lang":"en","source":"isco08"},{"text":"Fire prevention specialist","lang":"en","source":"isco08"},{"text":"Geotechnical technician","lang":"en","source":"isco08"},{"text":"Surveying technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3113","level":4,"parent_code":"311","isco_major":"3","isco_unit":"3113","skill_level":3,"label_en":"Electrical Engineering Technicians","label_hi":null,"description_en":"Electrical engineering technicians perform technical tasks to aid in electrical engineering research and in the design, manufacture, assembly, construction, operation, maintenance and repair of electrical equipment, facilities and distribution systems.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Electrical Engineering Technicians","lang":"en","source":"isco08"},{"text":"Electrical engineering technician","lang":"en","source":"isco08"},{"text":"Electric power transmission engineering technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3114","level":4,"parent_code":"311","isco_major":"3","isco_unit":"3114","skill_level":3,"label_en":"Electronics Engineering Technicians","label_hi":null,"description_en":"Electronics engineering technicians perform technical tasks to aid in electronic research and in the design, manufacture, assembly, construction, operation, maintenance and repair of electronic equipment.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Electronics Engineering Technicians","lang":"en","source":"isco08"},{"text":"Electronics engineering technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3115","level":4,"parent_code":"311","isco_major":"3","isco_unit":"3115","skill_level":3,"label_en":"Mechanical Engineering Technicians","label_hi":null,"description_en":"Mechanical engineering technicians perform technical tasks to aid in mechanical engineering research, and in the design, manufacture, assembly, construction, operation, maintenance and repair of machines, components and mechanical equipment.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Mechanical Engineering Technicians","lang":"en","source":"isco08"},{"text":"Aeronautics engineering technician","lang":"en","source":"isco08"},{"text":"Marine engineering technician","lang":"en","source":"isco08"},{"text":"Marine surveyor","lang":"en","source":"isco08"},{"text":"Mechanical engineering estimator","lang":"en","source":"isco08"},{"text":"Mechanical engineering technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3116","level":4,"parent_code":"311","isco_major":"3","isco_unit":"3116","skill_level":3,"label_en":"Chemical Engineering Technicians","label_hi":null,"description_en":"Chemical engineering technicians perform technical tasks to aid in chemical engineering research and in the design, manufacture, construction, operation, maintenance and repair of chemical plant.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Chemical Engineering Technicians","lang":"en","source":"isco08"},{"text":"Chemical engineering estimator","lang":"en","source":"isco08"},{"text":"Chemical engineering technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3117","level":4,"parent_code":"311","isco_major":"3","isco_unit":"3117","skill_level":3,"label_en":"Mining and metallurgical technicians","label_hi":null,"description_en":"Mining and metallurgical technicians perform technical tasks to assist in research and experiments related to metallurgy, in improving methods of extracting solid minerals, oil and gas, and in the design, construction, operation, maintenance and repair of mines and mine installations, of systems for transporting and storing oil and natural gas, and for extraction of metals from ores.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Mining and metallurgical technicians","lang":"en","source":"isco08"},{"text":"Metallurgical technician","lang":"en","source":"isco08"},{"text":"Mines inspector","lang":"en","source":"isco08"},{"text":"Mining engineering technician","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3118","level":4,"parent_code":"311","isco_major":"3","isco_unit":"3118","skill_level":3,"label_en":"Draughtspersons","label_hi":null,"description_en":"Draughtspersons prepare technical drawings, maps and illustrations from sketches, measurements and other data, and copy final drawings and paintings onto printing plates.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Draughtspersons","lang":"en","source":"isco08"},{"text":"Draughtsperson","lang":"en","source":"isco08"},{"text":"Technical illustrator","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"3119","level":4,"parent_code":"311","isco_major":"3","isco_unit":"3119","skill_level":3,"label_en":"Physical and Engineering Science Technicians Not Elsewhere Classified","label_hi":null,"description_en":"This unit group covers physical and engineering science technicians not classified elsewhere in Minor Group 311: Physical and Engineering Science Technicians. For instance, the unit group includes those who assist scientists and engineers engaged in developing procedures or conducting research on safety, biomedical, environmental or industrial and production engineering.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Physical and Engineering Science Technicians Not Elsewhere Classified","lang":"en","source":"isco08"},{"text":"Engineering technician (production)","lang":"en","source":"isco08"},{"text":"Fire investigator","lang":"en","source":"isco08"},{"text":"Forensic science technician","lang":"en","source":"isco08"},{"text":"Quantity surveying technician","lang":"en","source":"isco08"},{"text":"Robotics technician","lang":"en","source":"isco08"},{"text":"Time and motion study technician","lang":"en","source":"isco08"}]}
