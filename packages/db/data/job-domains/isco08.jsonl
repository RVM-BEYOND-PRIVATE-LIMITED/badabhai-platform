{"source":"isco08","code":"6320","level":4,"parent_code":"632","isco_major":"6","isco_unit":"6320","skill_level":2,"label_en":"Subsistence Livestock Farmers","label_hi":null,"description_en":"Subsistence livestock farmers breed, raise and tend livestock in order to provide food, shelter and, in some cases, a minimum of cash income for themselves and their households.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Subsistence Livestock Farmers","lang":"en","source":"isco08"},{"text":"Subsistence cattle farmer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"633","level":3,"parent_code":"63","isco_major":"6","isco_unit":null,"skill_level":2,"label_en":"Subsistence Mixed Crop and Livestock Farmers","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"6330","level":4,"parent_code":"633","isco_major":"6","isco_unit":"6330","skill_level":2,"label_en":"Subsistence Mixed Crop and Livestock Farmers","label_hi":null,"description_en":"Subsistence mixed crop and livestock farmers grow and harvest field or tree and shrub crops, vegetables and fruit; gather wild fruits and medicinal and other plants; tend or hunt animals; and/or catch fish and gather various forms of aquatic life in order to provide food, shelter and, in some cases, a minimum of cash income for themselves and their households.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Subsistence Mixed Crop and Livestock Farmers","lang":"en","source":"isco08"},{"text":"Mixed subsistence farmer","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"634","level":3,"parent_code":"63","isco_major":"6","isco_unit":null,"skill_level":2,"label_en":"Subsistence Fishers, Hunters, Trappers and Gatherers","label_hi":null,"description_en":null,"selectable":false,"industry_id":null,"canonical_role_id":null,"aliases":[]}
{"source":"isco08","code":"6340","level":4,"parent_code":"634","isco_major":"6","isco_unit":"6340","skill_level":2,"label_en":"Subsistence Fishers, Hunters, Trappers and Gatherers","label_hi":null,"description_en":"Subsistence fishers, hunters, trappers and gatherers gather wild fruits, medicinal and other plants; hunt and trap animals; catch fish and gather various forms of aquatic life in order to provide food, shelter and, in some cases, a minimum of cash income for themselves and their households.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Subsistence Fishers, Hunters, Trappers and Gatherers","lang":"en","source":"isco08"},{"text":"Hunter-gatherer","lang":"en","source":"isco08"},{"text":"Subsistence collector","lang":"en","source":"isco08"},{"text":"Subsistence diver","lang":"en","source":"isco08"},{"text":"Subsistence fisher","lang":"en","source":"isco08"},{"text":"Subsistence trapper","lang":"en","source":"isco08"}]}
