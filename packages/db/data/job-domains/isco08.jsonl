{"source":"isco08","code":"7316","level":4,"parent_code":"731","isco_major":"7","isco_unit":"7316","skill_level":2,"label_en":"Sign Writers, Decorative Painters, Engravers and Etchers","label_hi":null,"description_en":"Sign writers, decorative painters, engravers and etchers decorate articles made of wood, metal, textiles, glass, ceramics and other materials. They plan, lay out and paint letters, figures, monograms and designs to make signs and engrave and etch ornamental and floral designs on glass and other articles.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Sign Writers, Decorative Painters, Engravers and Etchers","lang":"en","source":"isco08"},{"text":"Decorative painter","lang":"en","source":"isco08"},{"text":"Glass enameller","lang":"en","source":"isco08"},{"text":"Glass engraver","lang":"en","source":"isco08"},{"text":"Glass etcher","lang":"en","source":"isco08"},{"text":"Signwriter","lang":"en","source":"isco08"},{"text":"Signwriters, Decorative Painters, Engravers and Etchers","lang":"en","source":"isco08"}]}
{"source":"isco08","code":"7317","level":4,"parent_code":"731","isco_major":"7","isco_unit":"7317","skill_level":2,"label_en":"Handicraft Workers in Wood, Basketry and Related Materials","label_hi":null,"description_en":"Handicraft workers in wood, basketry and related materials apply traditional techniques such as seasoning, impregnation to prepare wood, straw, rattan, reeds, clay, shells and other materials, and carve, mould, assemble, weave or paint and decorate various articles for personal or household use or for decorative purposes. Basketry weavers, brush makers and related workers select and prepare materials such as bristles, nylon, fibre, bass, whisker and wire to make wicker furniture, brushes and brooms, and weave various kinds of baskets.","selectable":true,"industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Handicraft Workers in Wood, Basketry and Related Materials","lang":"en","source":"isco08"},{"text":"Basket maker","lang":"en","source":"isco08"},{"text":"Brush maker","lang":"en","source":"isco08"},{"text":"Reed weaving handicraft worker","lang":"en","source":"isco08"},{"text":"Wicker furniture maker","lang":"en","source":"isco08"},{"text":"Wooden articles handicraft worker","lang":"en","source":"isco08"}]}
