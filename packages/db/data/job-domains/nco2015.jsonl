{"source":"nco2015","code":"1323.0100","level":5,"parent_code":"1323","parent_source":"isco08","isco_major":"1","isco_unit":"1323","skill_level":null,"label_en":"Title Mining Managers Manager, Construction/Manager","label_hi":null,"description_en":"Manager, Construction co-ordinates and supervises, within powers delegated, activities of public or private organizations or one or more of its departments or branches engaged in construction, maintenance and repairs of buildings, roads, railway tracks, aerodromes, bridges, canals, dams, etc. Is designated according to work performed or powers delegated such as: MANAGER, CONSTRUCTION. PROJECT MANAGER, CONSTRUCTION MANAGER EXCAVATIONS, CONSTRUCTION.","selectable":true,"status":"active","industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Title Mining Managers Manager, Construction/Manager","lang":"en","source":"nco2015"},{"text":"Manager, Construction/Manager Construction Projects","lang":"en","source":"nco2015"}]}
