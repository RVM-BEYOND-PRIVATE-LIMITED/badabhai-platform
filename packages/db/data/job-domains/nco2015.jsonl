{"source":"nco2015","code":"1221.0301","level":5,"parent_code":"1221","parent_source":"isco08","isco_major":"1","isco_unit":"1221","skill_level":null,"label_en":"Home Delivery Manager","label_hi":null,"description_en":"UME II A 26 Division 1 Territory Sales Manager (Prepaid) is responsible for distribution expansion and co-ordination with urban distributors, i.e. multi brand distributors, to achieve sales targets in the assigned territory achieving revenue targets people development channel management retailer education range selling increasing customer base and process compliance. (Rural Distributor)-Individual at this job is responsible for similar activities but with rural i.e. company specific distributors Qualification Pack Details: QP NOS Reference TEL/Q0203 QP NOS Name Territory Sales Manager (Prepaid) NSQF Level 7","selectable":true,"status":"active","industry_id":null,"canonical_role_id":null,"aliases":[{"text":"Home Delivery Manager","lang":"en","source":"nco2015"}]}
