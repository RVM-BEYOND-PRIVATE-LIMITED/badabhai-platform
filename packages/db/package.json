{
  "name": "@badabhai/db",
  "version": "0.1.0",
  "private": true,
  "description": "BadaBhai database package — Drizzle schema, migrations, and client for Supabase Postgres.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "db:seed:questionnaire": "tsx src/seed-questionnaire.ts",
    "db:seed:jobs": "tsx src/seed-jobs.ts",
    "db:seed:demand": "tsx src/seed-demand.ts",
    "db:seed:skills": "tsx src/seed-skills.ts",
    "db:embed:skills": "tsx src/embed-skill-aliases.ts",
    "db:seed:domains": "tsx src/seed-job-domains.ts",
    "db:embed:domains": "tsx src/embed-job-domain-aliases.ts",
    "db:verify:domains": "tsx src/verify-job-domains.ts",
    "db:normalize:aliases": "tsx src/normalize-job-domain-aliases.ts",
    "db:verify:aliases": "tsx src/verify-alias-lifecycle.ts",
    "db:normalize:skill-aliases": "tsx src/normalize-skill-aliases.ts",
    "db:eval:occupation": "tsx src/eval-occupation-retrieval.ts",
    "db:seed:packs": "tsx src/seed-question-packs.ts",
    "db:verify:packs": "tsx src/verify-question-packs.ts",
    "db:verify:trainer-pack": "tsx src/verify-trainer-pack.ts",
    "db:gen:aliases": "tsx src/generate-domain-aliases.ts",
    "db:gen:domain-skills": "tsx src/generate-domain-skills.ts",
    "db:seed:domain-skills": "tsx src/seed-domain-skills.ts",
    "db:verify:taxonomy": "tsx src/taxonomy-corpus.ts",
    "db:report:taxonomy": "tsx src/taxonomy-quality-gate.ts",
    "db:eval:taxonomy": "tsx src/taxonomy-retrieval-eval.ts",
    "db:replay:path-a": "tsx src/replay-path-a.ts",
    "db:embed:replay-queries": "tsx src/embed-replay-queries.ts",
    "db:mine:aliases": "tsx src/mine-chat-aliases.ts",
    "db:growth:cluster": "tsx src/growth-cluster.ts",
    "db:growth:occupation": "tsx src/growth-occupation.ts",
    "db:retag:skills": "tsx src/retag-skills.ts",
    "db:reencrypt:pii": "tsx src/reencrypt-pii-backfill.ts",
    "db:verify:demand": "tsx src/verify-demand.ts",
    "db:seed:reach": "tsx src/seed-reach-pool.ts",
    "db:seed:reach:large": "tsx src/seed-reach-pool.ts",
    "db:unseed:reach": "tsx src/seed-reach-pool.ts --unseed-only",
    "db:verify:reach": "tsx src/verify-reach.ts",
    "db:seed:match:vocabulary": "tsx src/seed-match-vocabulary.ts",
    "db:backfill:worker-skills": "tsx src/backfill-worker-skills.ts",
    "db:backfill:job-postings": "tsx src/backfill-job-postings-v1.ts",
    "db:convert:seed-jobs": "tsx src/convert-seed-jobs.ts",
    "db:materialize:reach": "tsx src/materialize-job-reach.ts",
    "db:grant:free-tier": "tsx src/grant-free-tier.ts",
    "db:bootstrap:admin": "tsx src/bootstrap-admin.ts",
    "db:admin:reset-mfa": "tsx src/reset-admin-mfa.ts",
    "db:verify:match-v1": "tsx src/verify-match-v1.ts",
    "clean": "rimraf --glob dist .turbo *.tsbuildinfo",
    "db:audit:domains": "tsx src/audit-job-domains.ts",
    "db:score:wedge": "tsx src/score-wedge.ts",
    "db:scale:taxonomy": "tsx src/taxonomy-scale-sim.ts",
    "db:promote:skills": "tsx src/promote-skills.ts",
    "db:sweep:floor": "tsx src/taxonomy-floor-sweep.ts",
    "db:experiment:alias": "tsx src/taxonomy-alias-experiment.ts",
    "db:audit:labels": "tsx src/taxonomy-label-audit.ts",
    "db:review-pack:fixture": "tsx src/taxonomy-fixture-review-pack.ts",
    "db:review-pack:td01": "tsx src/td01-review-pack.ts",
    "db:review-pack:eval-coverage": "tsx src/eval-coverage-review-pack.ts",
    "db:audit:embeddings": "tsx src/audit-embedding-provenance.ts",
    "db:verify:embeddings": "tsx src/verify-embedding-provenance.ts",
    "db:audit:schema-contract": "tsx src/audit-schema-contract.ts",
    "db:audit:rls": "tsx src/audit-rls.ts",
    "db:verify:path-b-parity": "tsx src/verify-path-b-parity.ts",
    "db:verify:unresolved-write": "tsx src/verify-unresolved-write.ts",
    "db:verify:rls-lock": "tsx src/verify-rls-lock.ts",
    "db:rollback:s3d": "tsx src/s3d-rollback.ts",
    "db:report:s3d-shadow": "tsx src/s3d-shadow-report.ts",
    "db:report:oie-canonicalize-coverage": "tsx src/oie-canonicalize-coverage.ts",
    "db:audit:live-drift": "tsx src/audit-live-drift.ts",
    "db:audit:live-drift:ci": "tsx src/live-drift-ci.ts",
    "db:audit:undeclared-routines": "tsx src/audit-undeclared-routines.ts",
    "db:export:alias-vectors": "tsx src/export-alias-vectors.ts"
  },
  "dependencies": {
    "@badabhai/ai-contracts": "workspace:*",
    "@badabhai/match-engine": "workspace:*",
    "@badabhai/profiling-lexicon": "workspace:*",
    "@badabhai/reach-engine": "workspace:*",
    "@badabhai/taxonomy": "workspace:*",
    "@badabhai/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@badabhai/validators": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2"
  }
}
