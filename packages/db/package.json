{
  "name": "@badabhai/db",
  "version": "0.1.0",
  "private": true,
  "description": "BadaBhai database package — Drizzle schema, migrations, and client for Supabase Postgres.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "db:seed:questionnaire": "tsx src/seed-questionnaire.ts",
    "db:seed:jobs": "tsx src/seed-jobs.ts",
    "db:seed:demand": "tsx src/seed-demand.ts",
    "db:seed:skills": "tsx src/seed-skills.ts",
    "db:embed:skills": "tsx src/embed-skill-aliases.ts",
    "db:seed:domains": "tsx src/seed-job-domains.ts",
    "db:embed:domains": "tsx src/embed-job-domain-aliases.ts",
    "db:verify:domains": "tsx src/verify-job-domains.ts",
    "db:growth:cluster": "tsx src/growth-cluster.ts",
    "db:retag:skills": "tsx src/retag-skills.ts",
    "db:reencrypt:pii": "tsx src/reencrypt-pii-backfill.ts",
    "db:verify:demand": "tsx src/verify-demand.ts",
    "db:seed:reach": "tsx src/seed-reach-pool.ts",
    "db:seed:reach:large": "tsx src/seed-reach-pool.ts",
    "db:unseed:reach": "tsx src/seed-reach-pool.ts --unseed-only",
    "db:verify:reach": "tsx src/verify-reach.ts",
    "db:seed:match:vocabulary": "tsx src/seed-match-vocabulary.ts",
    "db:backfill:worker-skills": "tsx src/backfill-worker-skills.ts",
    "db:backfill:job-postings": "tsx src/backfill-job-postings-v1.ts",
    "db:convert:seed-jobs": "tsx src/convert-seed-jobs.ts",
    "db:materialize:reach": "tsx src/materialize-job-reach.ts",
    "db:grant:free-tier": "tsx src/grant-free-tier.ts",
    "db:bootstrap:admin": "tsx src/bootstrap-admin.ts",
    "db:admin:reset-mfa": "tsx src/reset-admin-mfa.ts",
    "db:verify:match-v1": "tsx src/verify-match-v1.ts",
    "clean": "rimraf --glob dist .turbo *.tsbuildinfo",
    "db:audit:domains": "tsx src/audit-job-domains.ts"
  },
  "dependencies": {
    "@badabhai/match-engine": "workspace:*",
    "@badabhai/reach-engine": "workspace:*",
    "@badabhai/taxonomy": "workspace:*",
    "@badabhai/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@badabhai/validators": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2"
  }
}
