# ---- Node / pnpm / Turborepo ----
node_modules/
.pnpm-store/
dist/
build/
.turbo/
*.tsbuildinfo
coverage/

# ---- Claude Code ----
# Background-agent run transcripts — never commit these. The tracked engineering
# org (.claude/agents, .claude/skills, .claude/hooks, settings) is NOT ignored.
.claude/tasks/

# ---- Next.js ----
.next/
out/
next-env.d.ts
# Keep the committed web next-env.d.ts so CI typecheck works without a prior build.
!apps/web/next-env.d.ts

# ---- Environment & secrets (NEVER commit real values) ----
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
service-account*.json

# ---- Python (apps/ai-service) ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Flutter ----
# Path-agnostic: only the worker-app path was ignored below, so a stray
# `apps/.dart_tool/` got committed (Dart tooling writes one wherever it resolves a
# package graph). Its package_config.json embeds ABSOLUTE local paths
# (file:///home/<user>/.pub-cache/...) — machine-specific, useless to anyone else,
# and regenerated on every `pub get`. Ignore it at ANY depth so this cannot recur.
.dart_tool/

# ---- Flutter (apps/worker-app) ----
apps/worker-app/.dart_tool/
apps/worker-app/.flutter-plugins
apps/worker-app/.flutter-plugins-dependencies
apps/worker-app/build/
apps/worker-app/.idea/
*.iml

# ---- Supabase local ----
infra/supabase/.branches/
infra/supabase/.temp/
**/supabase/.temp/

# ---- Editor / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
logs/

# ---- Docker Compose local overrides (TD72b — docker-compose auto-loads, silence drift) ----
docker-compose.override.yml

# ---- Redis (local dev dumps — may contain OTP/session/PII; NEVER commit) ----
dump.rdb
*.rdb

# ---- Agent scratch space ----
.claude/worktrees/
.scratch

# Derived embedding vectors for the offline taxonomy experiments. Megabytes of floats that
# the provider can regenerate on demand — a local cost optimisation, not evidence. The
# evidence is the committed experiment record under data/taxonomy/eval/experiments/.
.embed-cache/

# ---- Agent tooling: PER-MACHINE state, not team config ----
# Generated by the local agent harness, not by any build step, and referenced by no
# CI job. `.claude/settings.json` stays TRACKED deliberately — the permission and hook
# policy is a team decision and belongs in review; what is ignored here is the
# machine-local scaffolding that happens to live beside it. If skills ever become
# something the team shares deliberately, that is a decision to make on purpose rather
# than by whoever ran an agent last.
.agents/
.claude/skills/
skills-lock.json
