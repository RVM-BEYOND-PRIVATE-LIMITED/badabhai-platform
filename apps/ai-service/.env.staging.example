# =============================================================================
# STAGING-ONLY real-LLM enablement for the AI service (profile_extraction).
# Template — NO SECRETS. Copy into the STAGING environment's secrets (or a staging
# `.env` that is NEVER committed) and fill the <...> placeholders.
#
# DO NOT use on a dev laptop, in CI, or against production worker data. The repo
# default stays mock: .env.example keeps AI_ENABLE_REAL_CALLS=false and
# AI_REAL_CALL_TASKS= (empty). Full runbook + verification + rollback:
#   docs/ai/enable-real-llm-extraction.md
#
# Gate (config.py): a real call needs the master flag AND the Gemini key
# (GEMINI_FLASH_API_KEY) AND the task explicitly listed in AI_REAL_CALL_TASKS
# (empty allowlist = NO tasks; fail-closed, no wildcard). The Anthropic key only
# ADDS the Claude Haiku fallback candidate.
# =============================================================================

# --- the flip ---------------------------------------------------------------
AI_ENABLE_REAL_CALLS=true
AI_REAL_CALL_TASKS=profile_extraction        # ONLY canonicalization goes real; chat/resume stay mock
# "profiling_chat_turn": TaskRoute("profiling_chat_turn", "cheap", …)   # → DEFAULT_CHEAP_MODEL
# "profile_extraction": TaskRoute("profile_extraction", "capable", …)   # → DEFAULT_CAPABLE_MODEL
# "resume_generation":  TaskRoute("resume_generation",  "cheap", …)     # → DEFAULT_CHEAP_MODEL

AI_REAL_CALLS_KILL_SWITCH=false   # set true to instantly disable ALL real calls, regardless of AI_ENABLE_REAL_CALLS
# --- Primary provider: Google AI Studio (Gemini), called DIRECTLY over REST ---
# (httpx — NO litellm, NO openai SDK). GEMINI_FLASH_API_KEY is the master gate
# for real calls. Secret — never commit.
GEMINI_FLASH_API_KEY=<your Gemini API key>
# Extraction tier (bare model id). NOTE: gemini-2.0-flash has free-tier quota = 0
# (429 RESOURCE_EXHAUSTED) and the free 2.5 tier caps at ~20 req/day — the full
# ~50-call eval needs PAID billing (or --min-interval/--per-tier to fit a free cap).
DEFAULT_CAPABLE_MODEL=gemini-2.5-flash

# --- Fallback provider: Anthropic (Claude Haiku) — OPTIONAL ------------------
# Reached via the official `anthropic` SDK. Its presence only adds a fallback
# candidate after a Gemini failure; it can NOT enable real calls on its own.
ANTHROPIC_API_KEY=<anthropic key, optional>
DEFAULT_FALLBACK_MODEL=claude-haiku-4-5

# --- generalized profiling: the LLM-driven chat path -------------------------
# The chat turn is now a REAL LLM call every turn — the deterministic question bank
# is gone. Add it to the allowlist above only when you intend to spend on it.
#
# The Resume Field Set: what the model must come away with. It invents its own
# questions per worker and per trade; this is the goal, and it is DATA so adding a
# trade never means editing Python. Location is two fields on purpose.
PROFILING_REQUIRED_FIELDS=trade,skills,experience_years,current_city,preferred_locations,salary_expected,availability
PROFILING_OPTIONAL_FIELDS=tools_equipment,salary_current,education_level,education_field,certifications,work_history,languages,relocation_willingness
# Hard turn cap — with one real call per turn this IS the per-worker cost ceiling.
PROFILING_MAX_TURNS=30
# History window in TURNS. Re-sending the full transcript each turn is O(n^2) input
# cost; a window makes it O(n * window). 0 = unbounded.
PROFILING_HISTORY_MAX_TURNS=20
# The persona spec is mechanically checkable, so it is ENFORCED per reply (one "?",
# <=20 words, closed ack set, banned words, no "!", no emoji) rather than hoped for.
PROFILING_PERSONA_GUARD_ENABLED=true
PROFILING_MAX_REPLY_WORDS=20
PROFILING_PERSONA_REPAIR_RETRIES=1

# --- job-domain RAG match (once, at the end — never per turn) ----------------
# Summary → embed → ANN over job_domain → shortlist → the model picks → the id is
# re-validated against the DB before any write. Keep OFF until the catalog is
# seeded (pnpm db:seed:domains) AND embedded (pnpm db:embed:domains). The floor is
# UNCALIBRATED — gate the flip on a labeled sweep, do not hand-tune it in prod.
DOMAIN_MATCH_ENABLED=false
DOMAIN_MATCH_TOP_K=10
DOMAIN_MATCH_FLOOR=0.55
DOMAIN_MATCH_AUTO_FLOOR=0.88
DOMAIN_MATCH_AUTO_MARGIN=0.08

# --- token caps + temperature (were hardcoded in ai/model_config.py) ---------
# The chat cap was 48, sized for the MOCK path where the model only rephrased a
# question the engine had already chosen. The turn now returns a JSON envelope
# (reply + chips + missing fields + captured values); 48 truncates every reply into
# a MAX_TOKENS failover, which is a silent quality cliff rather than an error.
AI_CHAT_MODEL_TIER=capable
AI_CHAT_MAX_OUTPUT_TOKENS=512
AI_CHAT_TEMPERATURE=0.3
AI_CHAT_MAX_RETRIES=1
AI_EXTRACTION_MAX_OUTPUT_TOKENS=1024
AI_EXTRACTION_TEMPERATURE=0.0
AI_EXTRACTION_MAX_RETRIES=2
AI_RESUME_MAX_OUTPUT_TOKENS=512
AI_RESUME_TEMPERATURE=0.4
AI_RESUME_MAX_RETRIES=1

# --- Gemini transport (were hardcoded in ai/gemini_client.py) ----------------
# Worst case = retries * backoff = 4 * 20s = 80s stalled inside ONE request.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RATE_LIMIT_RETRIES=4
GEMINI_MAX_BACKOFF_SECONDS=20.0
GEMINI_BACKOFF_BASE=2.0
GEMINI_THINKING_BUDGET=0         # 2.5 Flash is a thinking model; 0 = all output tokens go to the answer

# --- cost guardrails (INR) ---------------------------------------------------
# RAISED for the generalized flow (was Rs 4 target / Rs 6 alert / Rs 6 per user).
# The old numbers budgeted a chat that spent ZERO output tokens on the straight-line
# path; every turn is a real call now, plus summarize + domain-match + extraction +
# resume at the end. These two are ALERT/TARGET only, not enforcement.
AI_TARGET_PROFILE_COST_INR=15
AI_COST_ALERT_PROFILE_INR=20
# Per-call worst-case ceiling (a single call over this → refused → mock).
AI_MAX_CALL_COST_INR=10
# TD27 cumulative spend cap + retry budget (enforced in AIRouter.run BEFORE the
# provider call, fail-closed → mock; observable via GET /ai/spend + the
# ai.spend_cap_exceeded event). With AI_SPEND_REDIS_URL set (below) the spend caps
# enforce GLOBALLY across all Uvicorn workers; with it UNSET each worker holds its
# own (per-worker) counters — a multi-worker staging/prod MUST set it.
AI_MAX_DAILY_COST_INR=200        # rolling per-UTC-day cap (global when AI_SPEND_REDIS_URL set)
AI_MAX_TOTAL_COST_INR=1000       # process-lifetime cumulative spend cap (backstop)
# PER-USER daily budget (INR) — bounds ALL real AI spend for one worker/day
# (profiling chat + extraction + resume combined), keyed by the opaque worker_ref.
# This is the primary user-facing cap; the two above are the no-worker_ref backstop.
# RAISED Rs 6 -> Rs 25: this is the HARD per-worker stop, so leaving it at 6 while
# targeting Rs 15/profile would halt a legitimate interview partway through and
# leave a half-real, half-mock profile. Sized at ~1 completed profile/worker/day
# plus retry headroom — NOT at N profiles.
AI_MAX_USER_DAILY_COST_INR=25
AI_RETRY_BUDGET_PER_WINDOW=20    # max retries across all requests per window
AI_RETRY_BUDGET_WINDOW_SECONDS=60
# Independent hard kill-switch: set true to instantly disable ALL real calls,
# regardless of AI_ENABLE_REAL_CALLS. Default off.
AI_REAL_CALLS_KILL_SWITCH=false

# --- shared spend store (Redis) — REQUIRED for multi-worker real-call serving ---
# NOTE THE NAME: this is AI_SPEND_REDIS_URL, *not* REDIS_URL (AI-ENV-1, PR #401).
# The NestJS api's REDIS_URL is a DIFFERENT, mandatory store (sessions / OTP /
# BullMQ). The two used to share a name, so the wrong one could be picked up
# silently — a config error that surfaced as a ~21s stall, not an error. The
# ai-service now reads ONLY AI_SPEND_REDIS_URL; a plain REDIS_URL here is IGNORED.
#
# Backs the GLOBAL (cross-Uvicorn-worker) TD27 spend ledger. When set, the daily /
# cumulative / per-user (₹6) caps enforce across ALL workers via an atomic reserve;
# UNSET => the in-process backend (per-worker caps — fine for a single worker /
# local dev, NOT for a multi-worker deploy). FAIL-CLOSED: if it is set but Redis is
# unreachable, real calls are blocked → mock (never an unbounded spend), now on a
# 2s bound rather than a ~21s hang. The selected backend is logged at STARTUP.
# Malformed values (a missing redis:// scheme, a non-numeric port) fail at boot with
# an error naming this variable — and never echoing its value.
# PROVISION REDIS + SET THIS *BEFORE* AI_ENABLE_REAL_CALLS=true.
# Local (host-run AI service against the docker-compose redis): redis://localhost:6379/0
AI_SPEND_REDIS_URL=redis://<staging-redis-host>:6379/0

# --- observability (cost/profile in Langfuse, over PSEUDONYMIZED text only) ---
LANGFUSE_PUBLIC_KEY=<...>
LANGFUSE_SECRET_KEY=<...>

# --- per-field pytest gate target (only the staging pytest reads this; the CLI
#     uses --base-url). Unset => the real ≥90% test is SKIPPED, never failed. ---
AI_EVAL_BASE_URL=http://localhost:8000

# --- speech (Sarvam) — STAGING FLIP -------------------------------------------
# Absent from this file until now, which is itself a hazard: the flip runbook
# pointed at a staging template that documented none of the vars it needs.
#
# ARM ONE LEG AT A TIME. AI_REAL_CALL_TASKS is an allowlist and an EMPTY value
# blocks every task (fail-closed, no wildcard). Do TTS first — it is outbound-only,
# carries zero worker data and needs no consent conversation. STT sends real worker
# audio, which cannot be pseudonymized before the provider sees it.
#
#   step 1  AI_REAL_CALL_TASKS=tts_synthesis
#   step 2  AI_REAL_CALL_TASKS=tts_synthesis,stt_transcription   (also arms translate)
#
# GEMINI_FLASH_API_KEY is required even for a Sarvam-only flip: it is part of the
# single definition of "real calls are on" for the whole service.
# AI_ENABLE_REAL_CALLS=true
# AI_REAL_CALL_TASKS=
# SARVAM_API_KEY=
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_TTS_SPEAKER=anushka
# SARVAM_TTS_LANGUAGE=hi-IN
#
# STT additionally needs storage, since it fetches the clip itself. VOICE_NOTES_BUCKET
# MUST match the API side exactly — the two default differently ("" here vs a literal
# in config.py), and a mismatch is silent total transcription failure with a green
# /health.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# VOICE_NOTES_BUCKET=
