# =============================================================================
# AI service configuration — TEMPLATE. NO SECRETS.
#
# Copy to `apps/ai-service/.env`. Every value below is a SAFE MOCK DEFAULT: with
# this file as-is the service boots, serves every route, and makes ZERO outbound
# provider calls.
#
# READ THIS FIRST — WHICH FILE THE SERVICE LOADS.
# The ai-service reads `apps/ai-service/.env` and ONLY that file. `config.py`
# anchors env_file to this package (`_AI_SERVICE_ROOT`) rather than resolving it
# against the CWD, because `uvicorn app.main:app` run from the repo root used to
# silently load the ROOT .env — the NestJS API's — which defines OVERLAPPING names
# with INCOMPATIBLE meanings. Loading the wrong file produced a stall, not an
# error. The repo-root `.env.example` is NOT this service's template.
#
# THE REAL-CALL GATE, in order (config.py real_calls_blocked_reason):
#   1. AI_REAL_CALLS_KILL_SWITCH must be false   (checked FIRST, overrides all)
#   2. AI_ENABLE_REAL_CALLS must be true
#   3. GEMINI_FLASH_API_KEY must be set
#   4. the task must be listed in AI_REAL_CALL_TASKS
# An EMPTY AI_REAL_CALL_TASKS allows NOTHING. There is no wildcard. All four must
# hold or the call takes the mock path.
#
# Staging real-call enablement is a DIFFERENT file: .env.staging.example
# =============================================================================

# --- the real-call gate (all fail-closed) ------------------------------------
AI_ENABLE_REAL_CALLS=false
AI_REAL_CALL_TASKS=
AI_REAL_CALLS_KILL_SWITCH=false

# --- provider credentials (blank = mock; never commit real values) -----------
GEMINI_FLASH_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# --- model routing -----------------------------------------------------------
# Bare model ids, no provider prefix. Tiers map: chat + extraction -> capable,
# resume -> cheap.
DEFAULT_CHEAP_MODEL=gemini-2.5-flash-lite
DEFAULT_CAPABLE_MODEL=gemini-2.5-flash
DEFAULT_FALLBACK_MODEL=claude-haiku-4-5
EMBEDDING_MODEL=gemini-embedding-001

# --- generalized profiling: the Resume Field Set ------------------------------
# What the LLM must come away with. The model invents its own questions per worker
# and per trade; THIS is the goal, and it is data so a new trade never needs code.
#
# REQUIRED gates completion — the interview is not done until each is captured,
# declined, or the turn cap fires. Location is deliberately TWO fields: current
# and preferred are never conflated.
PROFILING_REQUIRED_FIELDS=trade,skills,experience_years,current_city,preferred_locations,salary_expected,availability
# OPTIONAL is captured-if-volunteered and NEVER asked. A worker who mentions ITI
# or a licence unprompted gets it on their resume without being interrogated.
PROFILING_OPTIONAL_FIELDS=tools_equipment,salary_current,education_level,education_field,certifications,work_history,languages,relocation_willingness

# --- generalized profiling: interview bounds ---------------------------------
# Hard turn cap. The interview ends when the model self-declares complete OR this
# fires. With a real LLM call every turn this is the per-worker cost ceiling.
PROFILING_MAX_TURNS=30
# Rolling history window in TURNS. Re-sending the whole transcript each turn makes
# input cost grow O(n^2); a window makes it O(n * window). 0 = send everything.
PROFILING_HISTORY_MAX_TURNS=20

# --- generalized profiling: the persona guard --------------------------------
# Most of the persona spec is mechanically checkable (one "?", <=20 words, a closed
# acknowledgement set, a banned-word list, no "!", no emoji), so it is ENFORCED on
# each reply rather than merely requested. A violation costs one repair retry.
PROFILING_PERSONA_GUARD_ENABLED=true
PROFILING_MAX_REPLY_WORDS=20
PROFILING_PERSONA_REPAIR_RETRIES=1

# --- job-domain RAG match (runs ONCE at the end, never per turn) --------------
# Summary -> embed -> ANN over job_domain -> shortlist -> the model picks -> the id
# is RE-VALIDATED against the DB before any write. Below the floor the profile is
# stored UNRESOLVED: a wrong domain is worse than no domain, so a match is never
# forced. Keep OFF until the catalog is seeded and embedded.
DOMAIN_MATCH_ENABLED=false
DOMAIN_MATCH_TOP_K=10
DOMAIN_MATCH_FLOOR=0.55
# The no-model shortcut: when one candidate clears AUTO_FLOOR *and* leads the runner-up
# by AUTO_MARGIN, it is taken directly — free, deterministic, recorded as `matched_auto`.
# BOTH conditions are required. A high score with a near-tied runner-up ("Lathe Operator"
# 0.90 vs "Lathe Maintenance Fitter" 0.89) is exactly the case that needs judgement, and
# is where a score-only rule would be wrong most confidently.
DOMAIN_MATCH_AUTO_FLOOR=0.88
DOMAIN_MATCH_AUTO_MARGIN=0.08
# The retrieval leg reuses the SKILLS seam (BACKEND_API_URL + SKILLS_INTERNAL_TOKEN
# above): the ai-service has no DB driver, so the api runs the ANN query on its owner
# connection. With either unset the match degrades to "no domain" — never an error.

# --- per-task token caps + temperature ---------------------------------------
# The chat turn's cap was 48, sized for the old mock path where the model only had
# to rephrase a pre-chosen question. It now returns a JSON envelope (reply, chips,
# missing fields, captured values), so 48 truncates every reply.
AI_CHAT_MODEL_TIER=capable
AI_CHAT_MAX_OUTPUT_TOKENS=512
AI_CHAT_TEMPERATURE=0.3
AI_CHAT_MAX_RETRIES=1
AI_EXTRACTION_MAX_OUTPUT_TOKENS=1024
AI_EXTRACTION_TEMPERATURE=0.0
AI_EXTRACTION_MAX_RETRIES=2
AI_RESUME_MAX_OUTPUT_TOKENS=512
AI_RESUME_TEMPERATURE=0.4
AI_RESUME_MAX_RETRIES=1

# --- Gemini transport ---------------------------------------------------------
# The retry chain must fit inside the deadline it runs under. GEMINI_MAX_BACKOFF_SECONDS
# caps ONE sleep; GEMINI_MAX_TOTAL_BACKOFF_SECONDS caps them ALL, which is the bound that
# matters — the per-sleep cap alone permitted retries * backoff = 4 * 20s = 80s stalled
# inside ONE request, against a parse deadline of 6s and an apps/api abort at 8s.
# A free tier wants 0-1 retries; a paid one with generous RPM can raise both.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RATE_LIMIT_RETRIES=1
GEMINI_MAX_BACKOFF_SECONDS=20.0
GEMINI_MAX_TOTAL_BACKOFF_SECONDS=5.0
GEMINI_BACKOFF_BASE=2.0
# 2.5 Flash is a "thinking" model. 0 = every output token goes to the answer, cost
# stays predictable, and the per-call ceiling stays meaningful.
GEMINI_THINKING_BUDGET=0

# --- cost guardrails (INR) ----------------------------------------------------
# Raised for the generalized flow. The old Rs 4/6 was a budget for a chat that
# spent ZERO output tokens on the straight-line path; every turn is a real call now.
# These two are ALERT/TARGET only.
AI_TARGET_PROFILE_COST_INR=15
AI_COST_ALERT_PROFILE_INR=20
# HARD stops below this line.
AI_MAX_CALL_COST_INR=10
AI_MAX_USER_DAILY_COST_INR=25
AI_MAX_DAILY_COST_INR=200
AI_MAX_TOTAL_COST_INR=1000
AI_RETRY_BUDGET_PER_WINDOW=20
AI_RETRY_BUDGET_WINDOW_SECONDS=60
# How long a provider stays skipped after it returns a 429 — the only guard here that
# outlives the request that found the rate limit. Everything else (the retry budget
# above, the client's in-call 429 loop, the router's attempt loop) resets for the next
# request, so a minute-long limit was met by every request in that minute walking the
# whole chain again. 60s matches a per-minute cap. 0 disables it.
AI_PROVIDER_COOLDOWN_SECONDS=60.0

# --- shared spend ledger ------------------------------------------------------
# NOTE THE NAME: AI_SPEND_REDIS_URL, *not* REDIS_URL. The NestJS API's REDIS_URL is
# a different, mandatory store; sharing the name silently armed this service against
# a store it does not own. UNSET = in-process backend (per-worker caps) — the correct
# dev/test default. A multi-worker deploy MUST set it. Fails CLOSED when unreachable.
#
# PREFER AN IP LITERAL OVER `localhost`. Fails-closed means unreachable == every real AI
# call blocked, surfacing as `budget_stopped: true, errors: 0` — which reads like an
# exhausted budget rather than an infrastructure fault. Seen in Phase 7: `localhost`
# resolved to ::1 first while docker compose publishes redis on 127.0.0.1 ONLY (deliberate
# loopback bind), so redis.asyncio timed out at 2s against a Redis that `redis-cli ping`
# answered instantly. `redis://127.0.0.1:6379` connects in 3ms.
#
# Note also that `docker compose up -d postgres` does NOT start redis; bring it up
# explicitly. Never "fix" spend_store_unavailable by unsetting this — that downgrades a
# global cap to a per-process one, i.e. weakens the guard while appearing to work.
# See docs/operations/ai-service-observability-config.md.
AI_SPEND_REDIS_URL=

# --- skill canonicalization (ADR-0030) — off by default -----------------------
SKILL_CANONICALIZE_ENABLED=false
SKILL_CANONICALIZE_FLOOR=0.75
SKILL_CANONICALIZE_TOP_K=5
SKILL_CANONICALIZE_DEFAULT_DOMAIN=cnc-machining
SKILL_GROWTH_MIN_CLUSTER_SIZE=2
SKILL_GROWTH_MIN_TOTAL_COUNT=3
SKILL_GROWTH_CLUSTER_THRESHOLD=0.80
SKILL_GROWTH_BAND_LOW=0.60

# --- internal seams (blank = inert) -------------------------------------------
# ai -> api, for the vector/upsert queries this service cannot run (it holds no DB
# driver by design). SKILLS_INTERNAL_TOKEN is deliberately scoped to the skills
# routes only — it is NOT the api's all-routes INTERNAL_SERVICE_TOKEN.
BACKEND_API_URL=
SKILLS_INTERNAL_TOKEN=
# api -> ai. When set, EVERY route except /health requires this exact value in the
# x-ai-internal-token header.
#
# LEAVE THIS LINE COMMENTED OUT. Unlike every other secret here, an EMPTY value is
# NOT a valid "off" — the field carries min_length=16 and an empty or short value
# FAILS AT STARTUP by design, because compare_digest("", "") is True and an empty
# token would arm the gate vacuously (passing every tokenless request while /health
# claimed the guard was on). Commented out = unset = the historical open posture,
# which is what you want locally. Set a real >=16-char value only in staging.
#
# Local note: if you DO set this in apps/ai-service/.env, the pytest suite will 401
# on ~138 tests. The conftest denylist neutralizes every other secret by blanking it,
# but it cannot blank this one (empty fails validation), so a local token leaks into
# the test run. CI has no .env and is unaffected.
# AI_INTERNAL_TOKEN=

# --- speech + translation (Sarvam) --------------------------------------------
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_STT_COST_INR_PER_CHUNK=0.25

# --- text-to-speech (Sarvam bulbul) -------------------------------------------
# The voice form's spoken questions. Rendered OFFLINE by
# `python -m app.cli.tts_render`, never per request: pack copy is static reviewed
# content, so the audio is a build artifact. No FastAPI route reaches the adapter
# (asserted by a boot test), so no request body can become speech.
# Needs `tts_synthesis` in AI_REAL_CALL_TASKS — its OWN key, so TTS can be armed
# without arming STT. That is the point of doing the outbound-only leg first.
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_OUTPUT_CODEC=wav
# Rate card: bulbul:v2 Rs 15/10k chars, bulbul:v3 Rs 30/10k. ESTIMATE until the
# first invoice. Sarvam rounds UP per request, so MIN_BILLED_CHARS models the floor
# — calibrate both from the tts_smoke run against the Sarvam dashboard.
SARVAM_TTS_COST_INR_PER_10K_CHARS=15.0
SARVAM_TTS_MIN_BILLED_CHARS=500

# --- Supabase Storage (voice-note reads only) ---------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VOICE_NOTES_BUCKET=worker-voice-notes

# --- observability -------------------------------------------------------------
# Tracing is silently disabled unless BOTH keys are present, so local dev never
# depends on Langfuse. Only PSEUDONYMIZED text is ever traced, and the tracer masks
# again on the way out (fail-closed) — see app/ai/langfuse_tracing.py.
# Requires the v4 SDK: pip install -r requirements-ai.txt
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud is the default; US cloud is https://us.cloud.langfuse.com
#
# THIS MUST MATCH THE REGION THE KEYS WERE ISSUED IN, and getting it wrong FAILS SILENTLY.
# A US key pair against the EU host does not disable tracing and does not raise: the service
# still logs "langfuse enabled", spans are still produced and masked, and the OTLP exporter
# is then rejected per batch with
#     opentelemetry.exporter.otlp.proto.http.trace_exporter: Failed to export span batch
#     code: 401
# on a logger nobody is watching. Every trace is dropped while every health signal says the
# tracing is fine. Observed for real: a Phase 7 corpus embed completed successfully, was
# metered correctly, and left NO trace at all — the gap was only caught because a gate
# checklist required reading the trace back out of Langfuse rather than trusting the log.
#
# If traces stop appearing, check this FIRST, and check it against the region of the keys —
# not against whether the value looks plausible.
# See docs/operations/ai-service-observability-config.md for the diagnosis procedure.
# THE REGION IS PART OF THE CREDENTIAL'S VALIDITY, and getting it wrong looks like a
# credential problem rather than a host problem: Langfuse answers a VALID key presented to
# the WRONG region with 401 "Invalid credentials. Confirm that you've configured the
# correct host." This project is on US. Measured 2026-08-27: the same keys return 200 on
# us.cloud.langfuse.com and 401 on cloud.langfuse.com. A wrong value here does not fail
# loudly — traces are simply rejected and the dashboard stays empty.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Which Langfuse environment these traces land in. SET THIS PER DEPLOYMENT: it is
# what keeps a staging box out of the production dashboards and evaluators. Left
# unset it defaults to "development", which is the safe way to be wrong.
LANGFUSE_TRACING_ENVIRONMENT=development
# Fetch production prompts from Langfuse Prompt Management instead of the in-image
# text. OFF is the committed default and keeps behaviour byte-identical to before
# prompt management existed — prompt VERSIONS are still recorded on every generation
# either way (as a content hash of the local text; see app/ai/prompt_registry.py).
#
# TURNING THIS ON HAS A REAL TRADE-OFF, not just a benefit: `interview_system_prompt`
# is GENERATED from the signed-off packages/profiling-lexicon/data/persona.json, and a
# Langfuse override bypasses the build-time gate that keeps the two in sync. Seed the
# Langfuse prompt from the current local text FIRST (that is what makes v1 mean "what
# already ships"), and treat an edit in the Langfuse UI as a persona change.
# Every fetch failure — network, missing prompt, unsupported SDK, empty body — falls
# back to the local text, so this can never make the service depend on Langfuse.
LANGFUSE_PROMPTS_ENABLED=false
# How long a fetched prompt is reused before re-checking. Bounds both the latency a
# prompt fetch can add to the request path and how stale a rollout can be.
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300

# --- AI CALL TRACE TEXT (migration 0083) ------------------------------------
# Whether this service returns the FINAL prompt and completion of each call on
# `AICallMetadata.prompt_text` / `response_text`, for the backend to store in
# `ai_call_traces`. DEFAULT OFF, and off means the table's two encrypted columns
# stay NULL — the backend has NO other source for that text and deliberately
# does not fall back to the request it assembled (that fallback is what put a
# worker's raw name, phone and address into the column before this flag existed).
#
# BOTH VALUES GO THROUGH THE SAME MASK OBJECT THE LANGFUSE SDK IS HANDED, i.e.
# through app/pseudonymize.py, in AIRouter._record_trace_text — the only writer.
# So turning this on stores POST-boundary text. That is a statement about which
# step ran, NOT that the text is clean: R32 measured the name gazetteer's recall
# as poor and R30's residuals are open, which is why the store encrypts at rest
# and gates the read on a super-admin-only capability.
#
# COSTS, measured/estimated and not load-tested: one extra pseudonymize pass over
# the whole message set per call (7-12 ms at the 20k gateway cap), and every
# `ai_metadata`-carrying response body grows by roughly the prompt size (~2.3 KB
# on /profile/extract, mostly system prompt).
#
# ONLY THE `AIRouter` SURFACES ARE COVERED — /profiling/*, /profile/extract,
# /profile/parse, /resume/generate, /job-posting/*. Embeddings (ai/embeddings.py)
# and STT/translate (app/stt.py, app/translate.py) do not route through it and
# populate neither field.
#
# Declared-empty is NOT unset for pydantic: `AI_CALL_TRACE_TEXT_ENABLED=""` raises
# a ValidationError at startup, same as AI_ENABLE_REAL_CALLS and
# LANGFUSE_PROMPTS_ENABLED. In compose use `${VAR:-false}`, never `${VAR:-}`.
AI_CALL_TRACE_TEXT_ENABLED=false

# The build these traces came from — the dimension that makes "did Tuesday's deploy
# change extraction quality?" answerable. A deploy should set this to a git sha; the
# default just mirrors the FastAPI app version.
APP_VERSION=0.1.0

AI_SERVICE_PORT=8000
