# =============================================================================
# AI service configuration — TEMPLATE. NO SECRETS.
#
# Copy to `apps/ai-service/.env`. Every value below is a SAFE MOCK DEFAULT: with
# this file as-is the service boots, serves every route, and makes ZERO outbound
# provider calls.
#
# READ THIS FIRST — WHICH FILE THE SERVICE LOADS.
# The ai-service reads `apps/ai-service/.env` and ONLY that file. `config.py`
# anchors env_file to this package (`_AI_SERVICE_ROOT`) rather than resolving it
# against the CWD, because `uvicorn app.main:app` run from the repo root used to
# silently load the ROOT .env — the NestJS API's — which defines OVERLAPPING names
# with INCOMPATIBLE meanings. Loading the wrong file produced a stall, not an
# error. The repo-root `.env.example` is NOT this service's template.
#
# THE REAL-CALL GATE, in order (config.py real_calls_blocked_reason):
#   1. AI_REAL_CALLS_KILL_SWITCH must be false   (checked FIRST, overrides all)
#   2. AI_ENABLE_REAL_CALLS must be true
#   3. GEMINI_FLASH_API_KEY must be set
#   4. the task must be listed in AI_REAL_CALL_TASKS
# An EMPTY AI_REAL_CALL_TASKS allows NOTHING. There is no wildcard. All four must
# hold or the call takes the mock path.
#
# Staging real-call enablement is a DIFFERENT file: .env.staging.example
# =============================================================================

# --- the real-call gate (all fail-closed) ------------------------------------
AI_ENABLE_REAL_CALLS=false
AI_REAL_CALL_TASKS=
AI_REAL_CALLS_KILL_SWITCH=false

# --- provider credentials (blank = mock; never commit real values) -----------
GEMINI_FLASH_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# --- model routing -----------------------------------------------------------
# Bare model ids, no provider prefix. Tiers map: chat + extraction -> capable,
# resume -> cheap.
DEFAULT_CHEAP_MODEL=gemini-2.5-flash-lite
DEFAULT_CAPABLE_MODEL=gemini-2.5-flash
DEFAULT_FALLBACK_MODEL=claude-haiku-4-5
EMBEDDING_MODEL=gemini-embedding-001

# --- generalized profiling: the Resume Field Set ------------------------------
# What the LLM must come away with. The model invents its own questions per worker
# and per trade; THIS is the goal, and it is data so a new trade never needs code.
#
# REQUIRED gates completion — the interview is not done until each is captured,
# declined, or the turn cap fires. Location is deliberately TWO fields: current
# and preferred are never conflated.
PROFILING_REQUIRED_FIELDS=trade,skills,experience_years,current_city,preferred_locations,salary_expected,availability
# OPTIONAL is captured-if-volunteered and NEVER asked. A worker who mentions ITI
# or a licence unprompted gets it on their resume without being interrogated.
PROFILING_OPTIONAL_FIELDS=tools_equipment,salary_current,education_level,education_field,certifications,work_history,languages,relocation_willingness

# --- generalized profiling: interview bounds ---------------------------------
# Hard turn cap. The interview ends when the model self-declares complete OR this
# fires. With a real LLM call every turn this is the per-worker cost ceiling.
PROFILING_MAX_TURNS=30
# Rolling history window in TURNS. Re-sending the whole transcript each turn makes
# input cost grow O(n^2); a window makes it O(n * window). 0 = send everything.
PROFILING_HISTORY_MAX_TURNS=20

# --- generalized profiling: the persona guard --------------------------------
# Most of the persona spec is mechanically checkable (one "?", <=20 words, a closed
# acknowledgement set, a banned-word list, no "!", no emoji), so it is ENFORCED on
# each reply rather than merely requested. A violation costs one repair retry.
PROFILING_PERSONA_GUARD_ENABLED=true
PROFILING_MAX_REPLY_WORDS=20
PROFILING_PERSONA_REPAIR_RETRIES=1

# --- job-domain RAG match (runs ONCE at the end, never per turn) --------------
# Summary -> embed -> ANN over job_domain -> shortlist -> the model picks -> the id
# is RE-VALIDATED against the DB before any write. Below the floor the profile is
# stored UNRESOLVED: a wrong domain is worse than no domain, so a match is never
# forced. Keep OFF until the catalog is seeded and embedded.
DOMAIN_MATCH_ENABLED=false
DOMAIN_MATCH_TOP_K=10
DOMAIN_MATCH_FLOOR=0.55
# The no-model shortcut: when one candidate clears AUTO_FLOOR *and* leads the runner-up
# by AUTO_MARGIN, it is taken directly — free, deterministic, recorded as `matched_auto`.
# BOTH conditions are required. A high score with a near-tied runner-up ("Lathe Operator"
# 0.90 vs "Lathe Maintenance Fitter" 0.89) is exactly the case that needs judgement, and
# is where a score-only rule would be wrong most confidently.
DOMAIN_MATCH_AUTO_FLOOR=0.88
DOMAIN_MATCH_AUTO_MARGIN=0.08
# The retrieval leg reuses the SKILLS seam (BACKEND_API_URL + SKILLS_INTERNAL_TOKEN
# above): the ai-service has no DB driver, so the api runs the ANN query on its owner
# connection. With either unset the match degrades to "no domain" — never an error.

# --- per-task token caps + temperature ---------------------------------------
# The chat turn's cap was 48, sized for the old mock path where the model only had
# to rephrase a pre-chosen question. It now returns a JSON envelope (reply, chips,
# missing fields, captured values), so 48 truncates every reply.
AI_CHAT_MODEL_TIER=capable
AI_CHAT_MAX_OUTPUT_TOKENS=512
AI_CHAT_TEMPERATURE=0.3
AI_CHAT_MAX_RETRIES=1
AI_EXTRACTION_MAX_OUTPUT_TOKENS=1024
AI_EXTRACTION_TEMPERATURE=0.0
AI_EXTRACTION_MAX_RETRIES=2
AI_RESUME_MAX_OUTPUT_TOKENS=512
AI_RESUME_TEMPERATURE=0.4
AI_RESUME_MAX_RETRIES=1

# --- Gemini transport ---------------------------------------------------------
# Worst case is retries * backoff = 4 * 20s = 80s stalled inside ONE request.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RATE_LIMIT_RETRIES=4
GEMINI_MAX_BACKOFF_SECONDS=20.0
GEMINI_BACKOFF_BASE=2.0
# 2.5 Flash is a "thinking" model. 0 = every output token goes to the answer, cost
# stays predictable, and the per-call ceiling stays meaningful.
GEMINI_THINKING_BUDGET=0

# --- cost guardrails (INR) ----------------------------------------------------
# Raised for the generalized flow. The old Rs 4/6 was a budget for a chat that
# spent ZERO output tokens on the straight-line path; every turn is a real call now.
# These two are ALERT/TARGET only.
AI_TARGET_PROFILE_COST_INR=15
AI_COST_ALERT_PROFILE_INR=20
# HARD stops below this line.
AI_MAX_CALL_COST_INR=10
AI_MAX_USER_DAILY_COST_INR=25
AI_MAX_DAILY_COST_INR=200
AI_MAX_TOTAL_COST_INR=1000
AI_RETRY_BUDGET_PER_WINDOW=20
AI_RETRY_BUDGET_WINDOW_SECONDS=60

# --- shared spend ledger ------------------------------------------------------
# NOTE THE NAME: AI_SPEND_REDIS_URL, *not* REDIS_URL. The NestJS API's REDIS_URL is
# a different, mandatory store; sharing the name silently armed this service against
# a store it does not own. UNSET = in-process backend (per-worker caps) — the correct
# dev/test default. A multi-worker deploy MUST set it. Fails CLOSED when unreachable.
AI_SPEND_REDIS_URL=

# --- skill canonicalization (ADR-0030) — off by default -----------------------
SKILL_CANONICALIZE_ENABLED=false
SKILL_CANONICALIZE_FLOOR=0.75
SKILL_CANONICALIZE_TOP_K=5
SKILL_CANONICALIZE_DEFAULT_DOMAIN=cnc-machining
SKILL_GROWTH_MIN_CLUSTER_SIZE=2
SKILL_GROWTH_MIN_TOTAL_COUNT=3
SKILL_GROWTH_CLUSTER_THRESHOLD=0.80
SKILL_GROWTH_BAND_LOW=0.60

# --- internal seams (blank = inert) -------------------------------------------
# ai -> api, for the vector/upsert queries this service cannot run (it holds no DB
# driver by design). SKILLS_INTERNAL_TOKEN is deliberately scoped to the skills
# routes only — it is NOT the api's all-routes INTERNAL_SERVICE_TOKEN.
BACKEND_API_URL=
SKILLS_INTERNAL_TOKEN=
# api -> ai. When set, EVERY route except /health requires this exact value in the
# x-ai-internal-token header.
#
# LEAVE THIS LINE COMMENTED OUT. Unlike every other secret here, an EMPTY value is
# NOT a valid "off" — the field carries min_length=16 and an empty or short value
# FAILS AT STARTUP by design, because compare_digest("", "") is True and an empty
# token would arm the gate vacuously (passing every tokenless request while /health
# claimed the guard was on). Commented out = unset = the historical open posture,
# which is what you want locally. Set a real >=16-char value only in staging.
#
# Local note: if you DO set this in apps/ai-service/.env, the pytest suite will 401
# on ~138 tests. The conftest denylist neutralizes every other secret by blanking it,
# but it cannot blank this one (empty fails validation), so a local token leaks into
# the test run. CI has no .env and is unaffected.
# AI_INTERNAL_TOKEN=

# --- speech + translation (Sarvam) --------------------------------------------
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_STT_COST_INR_PER_CHUNK=0.25

# --- Supabase Storage (voice-note reads only) ---------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VOICE_NOTES_BUCKET=worker-voice-notes

# --- observability -------------------------------------------------------------
# Tracing is silently disabled unless BOTH keys are present, so local dev never
# depends on Langfuse. Only PSEUDONYMIZED text is ever traced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

AI_SERVICE_PORT=8000
