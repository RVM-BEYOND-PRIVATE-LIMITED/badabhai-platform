<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) routes cold launches through the system SplashScreen
         API. Paint its splash background the light canvas so it matches the
         light-only Flutter first frame instead of the default launcher icon on a
         white/black window. Applies to both light and dark (no -night-v31). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/bb_launch_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/bb_launch_bg</item>
    </style>
</resources>
