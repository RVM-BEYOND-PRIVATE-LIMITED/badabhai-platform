# =============================================================================
# BadaBhai Platform — Environment Template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values for LOCAL development only.
# NEVER commit a real .env or real secrets. This file must contain ONLY
# placeholders. Service-role / API keys are backend-only and must NOT be
# exposed to the web or worker-app frontends.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development

# ---- Core datastores ----
# Local docker-compose Postgres (see docker-compose.yml). For Supabase, use the
# connection string from the Supabase dashboard (Project Settings > Database).
DATABASE_URL=postgresql://badabhai:badabhai@localhost:5432/badabhai
REDIS_URL=redis://localhost:6379

# ---- Supabase (BACKEND ONLY) ----
# SUPABASE_URL is safe to expose; the SERVICE_ROLE/SECRET key is a god-key — backend only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key-backend-only
# DSAR ERASURE SWEEP TARGET ONLY — nothing writes to this bucket, and it is not
# provisioned. ADR-0003's conversation-archival tier was WITHDRAWN on 2026-08-14 (risk
# R10 closed by the retirement): chat_messages already holds the durable transcript, so
# a bucket copy would only have doubled the raw-PII surface.
#
# The name is still configured because AccountDeletionService sweeps
# conversationWorkerPrefix(worker_id) against it on account deletion — defence in depth,
# correct against a bucket that does not exist (the Storage list 404s → nothing_to_delete).
# Do not provision it; reviving archival needs a new ADR.
CONVERSATIONS_BUCKET=worker-conversations
# Private Storage bucket for rendered resume PDFs (TD5). MUST be PRIVATE (anon denied):
# provision via infra/supabase/storage-buckets.sql (out-of-band, NOT a Drizzle migration —
# RLS only covers Postgres tables, not Storage object ACLs). Object keys are opaque UUIDs;
# the worker name lives in the PDF bytes, served only via short-TTL backend signed URLs.
RESUMES_BUCKET=worker-resumes
# Private Storage bucket for rendered per-trade interview-kit PDFs (Task 4). PII-FREE
# (per-trade, not per-worker) but still PRIVATE — provisioned by the same
# infra/supabase/storage-buckets.sql. Served only via short-TTL backend signed URLs.
INTERVIEW_KIT_BUCKET=interview-kits

# ---- Resume / interview-kit render worker (TD5/TD24, BACKEND ONLY) ----
# Master switch for the WeasyPrint render step (governs BOTH resume + interview-kit
# rendering — the requested WEASYPRINT_ENABLED maps onto this). Off by default so the
# API runs without the binary in local dev (renderer degrades to "no PDF this run").
# Set to true in staging/prod once the binary is present (the API Dockerfile installs it).
RESUME_RENDER_ENABLED=false
# Per-worker generations allowed per UTC day; global cap is the interim backstop
# until TD4 binds a request to an authenticated worker.
RESUME_DAILY_CAP=5
RESUME_GLOBAL_DAILY_CAP=5000
# Per-IP DOWNLOAD caps per rolling UTC hour (TD24 abuse backstop). The IP is
# HMAC-hashed before any Redis key/log. Fail-closed if Redis is down.
RESUME_RATE_LIMIT_PER_IP_PER_HOUR=20
INTERVIEW_KIT_RATE_LIMIT_PER_IP_PER_HOUR=20
# Actions one AUTHENTICATED worker may record per rolling UTC hour, across
# POST /workers/me/actions and its batch sibling (#694). Counted in ACTIONS, not
# requests, so 100 full batches cannot walk around a per-call cap. Same fail-closed
# idiom: a Redis outage rejects (429) rather than uncapping writes into `events`.
WORKER_ACTIONS_PER_HOUR=500
# Interview-kit content version — part of the render-once identity. BUMP whenever any
# kit copy (interview-kit-content.ts) changes so a fresh PDF renders instead of the cache.
INTERVIEW_KIT_CONTENT_VERSION=1
# Internal service secret (NOT user auth) gating the ops/backend-only resume routes
# (GET /resume/:id, /:id/download, /:id/share, /:id/regenerate). UNSET => those routes
# deny ALL callers (fail closed). Uncomment + set a strong random value to use them
# (ops/internal callers send it as the x-internal-service-token header). Real per-worker
# auth is TD4. Treat as a secret.
# INTERNAL_SERVICE_TOKEN=replace-with-a-strong-random-secret
# TTL (seconds) for a freshly minted signed resume-download URL (15 min default).
RESUME_SIGNED_URL_TTL_SECONDS=900
# Service bearer for the two ai-service-initiated skills routes (the REVERSE direction
# from AI_INTERNAL_TOKEN below — ai-service holds THIS token and can reach nothing but
# the skills routes, never the resume-PII or money routes). UNSET => those routes deny
# ALL callers (fail closed). Treat as a secret.
# SKILLS_INTERNAL_TOKEN=replace-with-a-strong-random-secret

# ---- PII protection (BACKEND ONLY) ----
# Pepper for the keyed HMAC of phone/IP (so hashes aren't brute-forceable), and an
# AES-256-GCM key (base64 of 32 bytes) for encrypting phone_e164 at rest. The key
# NEVER touches the database. REQUIRED in production — the API refuses to boot with
# the dev defaults when NODE_ENV=production. Generate fresh values with:
#   node -e "const c=require('crypto');console.log('PII_HASH_PEPPER='+c.randomBytes(32).toString('hex'));console.log('PII_ENCRYPTION_KEY='+c.randomBytes(32).toString('base64'))"
PII_HASH_PEPPER=replace-with-32+-byte-random-pepper
PII_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes

# ADR-0026 Phase 3 — device-unlock PIN pepper (BACKEND ONLY). A secret on par with
# PII_HASH_PEPPER: a leak of worker_credentials + the dev-public pepper would make the
# 10^4 PIN space brute-forceable. REQUIRED outside development/test (assertAuthConfig
# fails closed on the dev default). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_PEPPER=replace-with-32+-byte-random-pepper

# ---- Worker auth: OTP login + rolling session (BACKEND ONLY) ----
# Secret that signs the worker session JWT. REQUIRED in production — the API
# refuses to boot with the dev default when NODE_ENV is not development/test.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-32+-byte-random
# Session lifetime in days (token + Redis session share this TTL; rolling/sliding).
SESSION_TTL_DAYS=30
# OTP shape + lifecycle. The code is generated with crypto.randomInt per digit,
# stored in Redis ONLY as a keyed HMAC, single-use, and rate-limited per phone + IP.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
# Per-phone DAILY backstop (TD60) — MUST sit at/above the hourly cap (a lower daily would
# trip first and make the hourly cap unreachable). Stated explicitly so this template
# documents the real enforced value instead of silently diverging from the schema default.
#
# DO NOT RAISE THESE THREE HERE. README documents copying this file to the runtime env
# file, so it is the provisioning reference for a REAL-SMS environment (SMS_PROVIDER is
# fast2sms — there is no mock path). OTP_MAX_ATTEMPTS is the SOLE brute-force limiter on
# POST /auth/otp/verify: unlike otp/request, that route carries no per-IP cap. All three
# values are shared by the worker, payer AND ADMIN login paths. Handset-testing headroom
# belongs in a dev/CI-only override (see the CI env block in .github/workflows/ci.yml),
# never in the shipped template.
OTP_MAX_SENDS_PER_DAY=10
# Per-IP hourly cap on POST /auth/otp/request — a NETWORK-level abuse backstop, and NOT one
# of the three per-phone SMS budgets above. Its own knob because the two ask different
# questions: those bound how many texts ONE NUMBER may receive (paid Fast2SMS spend), this
# bounds how many humans may sign in from ONE EGRESS IP.
#
# Raising this does NOT widen SMS spend — the per-phone hourly/daily caps and the global
# breaker below are untouched, so no single number can be texted more. It only widens how
# many DISTINCT numbers may sign in from one network, which is what CGNAT and shared office
# wifi make unavoidable: TRUST_PROXY_HOP_COUNT defaults to 0 and the shipped topology has no
# reverse proxy, so req.ip is the NAT egress address and Indian carriers front thousands of
# subscribers behind one. Matches PAYER_AUTH_MAX_PER_IP_PER_HOUR / ADMIN_AUTH_MAX_PER_IP_PER_HOUR.
OTP_MAX_SENDS_PER_IP_PER_HOUR=20
# GLOBAL daily send circuit-breaker for the WORKER SMS path (OTP-5 — the SPEND ceiling).
# Bounds the TOTAL number of REAL Fast2SMS sends platform-wide per UTC day, above the
# per-phone + per-IP caps, so a distributed abuser cannot run up the bill. The SMS path is
# REAL-ONLY (Fast2SMS — no console fallback), so this ALWAYS enforces. Set to 0 to instantly
# PAUSE real sends (the worker-SMS KILL-SWITCH) — env-only, NO redeploy; the next send is
# blocked + a PII-free breach event fires. NEVER a secret.
OTP_GLOBAL_MAX_SENDS_PER_DAY=2000
# SMS delivery is REAL-ONLY: "fast2sms" is the only provider — there is NO console/mock
# option. The API REFUSES TO BOOT (fails closed) without the FAST2SMS_* credentials below
# in EVERY environment (assertAuthConfig). The literal keeps the env var for back-compat.
SMS_PROVIDER=fast2sms
# Fast2SMS (DLT route) — REQUIRED AT BOOT (the app fails closed without them). These are
# BACKEND-ONLY secrets; supply the real credentials + approved DLT template/variable order
# in staging-first. Placeholders only here — NEVER commit a real API key.
FAST2SMS_API_KEY=replace-with-real-fast2sms-api-key
FAST2SMS_SENDER_ID=BADBHI
FAST2SMS_DLT_TEMPLATE_ID=replace-with-real-dlt-template-id
FAST2SMS_ENTITY_ID=
FAST2SMS_ROUTE=dlt

# Selects the payer login channel (ADR-0019 B-R1): "email_otp" (default, REAL-ONLY email
# OTP), "whatsapp" (mock), or "supabase" (config-gated adapter, inert without
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY — fails closed rather than silently degrading).
PAYER_LOGIN_METHOD=email_otp

# ---- Payer email OTP (real provider — ADR-0019; human-gated, staging-first) ----
# These gate the REAL payer email-OTP channel and are RELEVANT ONLY when
# PAYER_LOGIN_METHOD=email_otp (the default). The channel is REAL-ONLY: there is NO "none"/
# mock option — a real provider's credentials are REQUIRED AT BOOT (assertPayerAuthConfig
# fails closed without them, never silently degrading). EMAIL_PROVIDER selects the transport:
# "zeptomail" (default), "smtp", or "auto". Supplying the real keys is human-gated +
# staging-first (CLAUDE.md §7). All keys are BACKEND-ONLY secrets — never NEXT_PUBLIC_*.
# Placeholders only here — NEVER commit a real ZeptoMail token (it is a long opaque string).
EMAIL_PROVIDER=zeptomail
# ZeptoMail (HTTPS send API). API_URL is a non-secret endpoint default; TOKEN + MAIL_AGENT
# are secrets REQUIRED when EMAIL_PROVIDER=zeptomail (or auto). Requires EMAIL_FROM_ADDRESS.
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_API_TOKEN=replace-with-real-zeptomail-token
ZEPTOMAIL_MAIL_AGENT=replace-with-real-mail-agent
ZEPTOMAIL_SANDBOX_MODE=false
# Generic SMTP relay (alternative to ZeptoMail). Required when EMAIL_PROVIDER=smtp (or auto
# without ZeptoMail creds). Requires EMAIL_FROM_ADDRESS below when used.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Shared From identity for the rendered email (both providers). EMAIL_FROM_ADDRESS is a
# required cred for every REAL provider; NAME + REPLY_TO are presentation-only.
EMAIL_FROM_NAME=BadaBhai
EMAIL_FROM_ADDRESS=otp@example.com
EMAIL_REPLY_TO=
# GLOBAL daily send circuit-breaker for the PAYER EMAIL-OTP path (OTP-5 — the SPEND
# ceiling; payer analogue of OTP_GLOBAL_MAX_SENDS_PER_DAY). Bounds the TOTAL number of
# REAL payer email sends platform-wide per UTC day. The email channel is REAL-ONLY
# (zeptomail/smtp), so this ALWAYS enforces. On breach the response stays byte-identical
# for a known vs unknown account (no enumeration oracle). Set to 0 to instantly PAUSE real
# sends (the payer-email KILL-SWITCH) — env-only, NO redeploy; the next send is blocked +
# a PII-free breach event fires. NEVER a secret.
PAYER_OTP_GLOBAL_MAX_SENDS_PER_DAY=2000

# Payer org teammate INVITES — real accept-link email (ADR-0027 / B5.4). The invite ACCEPT
# flow (single-use token verify → member activation) is ALWAYS live; only the outbound
# real-email DELIVERY is gated. MEMBER_INVITES_ENABLE_REAL defaults FALSE: the MOCK mailer
# (no send — the raw token / accept link never leaves the process) is the alpha default.
# Flipping it true reuses the REAL email provider above (EMAIL_PROVIDER + its creds) AND
# requires MEMBER_INVITE_ACCEPT_URL; it is human-gated + staging-first (CLAUDE.md §7). A
# real-enabled flag missing the email creds / accept URL fails CLOSED at boot. NEVER a secret.
MEMBER_INVITES_ENABLE_REAL=false
# Base URL of the payer-web invite-accept page. The single-use raw token is appended as
# `?token=…` to build the accept link that goes ONLY into the invite email body (never
# logged/evented). REQUIRED when MEMBER_INVITES_ENABLE_REAL=true; unused by the mock mailer.
MEMBER_INVITE_ACCEPT_URL=
# Per-org cap on concurrently non-removed members (active + invited) — a backstop against
# unbounded invite minting. Reaching it rejects further invites (409) until a seat frees up.
MEMBER_INVITE_MAX_PER_ORG=25

# ---- AI routing (direct Gemini, no LiteLLM) ----
# The AI service calls Google AI Studio (Gemini) DIRECTLY over REST with httpx —
# there is NO LiteLLM proxy. This key is backend/staging-only (never NEXT_PUBLIC_*,
# never the web/worker app). Placeholder only — set a real key in staging env.
GEMINI_FLASH_API_KEY=replace-with-google-ai-studio-key
# Master kill-switch for real LLM calls. MUST stay false unless intentionally
# enabling real model traffic. Pseudonymization always runs first regardless.
AI_ENABLE_REAL_CALLS=false
# Per-task allowlist for real calls (comma-separated). Lets ONE task go real while
# the rest stay mock.
#
# EMPTY = **NO** TASKS MAY GO REAL (fail-closed, owner-ruled 2026-08-01; there is no
# wildcard). This file previously said "EMPTY = all tasks", which was inverted — and
# inverted in the fail-OPEN direction, on the one page someone reads while arming a
# provider. `Settings.real_call_task_allowlist` in apps/ai-service/app/config.py is
# the enforcing code; believe it, not a comment.
#
# Requires the master flag AND GEMINI_FLASH_API_KEY, which is the single definition
# of "real calls are on" for the whole service — so even a Sarvam-only flip needs the
# Gemini key set.
#
# Tasks: profiling_chat_turn, profile_extraction, resume_generation,
#        stt_transcription (also arms Sarvam translate), skill_embedding,
#        tts_synthesis (its own key, so TTS can be armed without arming STT).
# Staging rollout: arm ONE at a time, e.g. AI_REAL_CALL_TASKS=tts_synthesis
AI_REAL_CALL_TASKS=

# WhatsApp invite funnel + re-engagement (ADR-0020). MOCK provider by default — no
# real message is sent and a worker's phone never leaves to Meta. Flipping
# MESSAGING_ENABLE_REAL=true requires the WhatsApp keys AND is human-gated +
# staging-first (CLAUDE.md §7); a real-enabled flag without keys fails closed at boot.
# Also requires the worker's `whatsapp_messaging` DPDP consent (fail-closed).
MESSAGING_ENABLE_REAL=false
# Meta WhatsApp Cloud API credentials — leave blank in dev/alpha (mock provider).
# Supplied only in staging-first behind MESSAGING_ENABLE_REAL. NEVER commit real values.
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Real payments — Razorpay credit-pack checkout (ADR-0010 §D5). MOCK ledger by default:
# with PAYMENTS_ENABLE_REAL=false the portal top-up grants credits with no money movement,
# the /payer/credits/order + /verify routes answer a neutral 404, and the webhook denies.
# Flipping it true is human-gated + staging-first (CLAUDE.md §7).
#
# ALL THREE VARS BELOW ARE REQUIRED TOGETHER. With the flag on and any of them unset the
# API REFUSES TO BOOT (assertPaymentsConfig) rather than silently running as mock — and a
# BLANK value ("FOO=") counts as unset, so it fails boot too. There is no half-configured
# real gateway. The boot error names the missing VARS only, never a value.
#
# Each is load-bearing for a different reason:
#   PAYMENTS_PROVIDER_KEY     the rzp_* KEY ID. Public by design — it is handed to the
#                             browser checkout on the order response. Not a secret.
#   PAYMENTS_PROVIDER_SECRET  the API key SECRET. Signs the server-to-server order call and
#                             verifies the browser-returned razorpay_signature. SERVER-ONLY.
#   RAZORPAY_WEBHOOK_SECRET   the per-webhook signing secret from the Razorpay dashboard —
#                             a DIFFERENT secret from the key secret, so rotating one does
#                             not invalidate the other. Without it every webhook fails
#                             verification, so captures would only ever land via the browser
#                             fallback and a buyer on a dropped connection would pay and
#                             never be credited. That is why "flag + key id" is NOT live.
#
# NEVER commit real values. The two secrets must never appear in a NEXT_PUBLIC_* var, a
# client bundle, a log line, or an event payload.
PAYMENTS_ENABLE_REAL=false
PAYMENTS_PROVIDER_KEY=
PAYMENTS_PROVIDER_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Worker push notifications (ADR-0034 — FCM). SECURITY ALERTS ONLY in this phase
# (new-device login + logged-out-everywhere). PUSH_ENABLE_REAL is the master gate and
# DEFAULTS FALSE: with it off the MOCK provider is bound and nothing leaves the process.
# Flipping it true requires the credential below AND is human-gated + staging-first
# (CLAUDE.md §7); a real-enabled flag without a credential fails CLOSED at boot.
# NOTE: this is NOT MESSAGING_ENABLE_REAL above — that is the WhatsApp invite funnel
# (ADR-0020), a different provider with a different spend profile and kill-switch.
PUSH_ENABLE_REAL=false
# Firebase service-account key, BASE64-ENCODED (`base64 -w0 service-account.json`).
# The encoding is REQUIRED, not cosmetic: the raw key is multi-line JSON containing a
# PEM private key, and the CI deploy bridges secrets to the box as shell env vars, which
# mangles embedded newlines/quotes. NEVER commit a real value.
FCM_SERVICE_ACCOUNT_B64=
FCM_PROJECT_ID=
# Global daily ceiling AND kill-switch. 0 = PAUSED = halt every push (including
# security), env-only, no redeploy. SECURITY pushes are EXEMPT from the numeric ceiling:
# FCM is free, so a count cap must never be able to drop a security alert.
PUSH_GLOBAL_MAX_SENDS_PER_DAY=5000
# Per-IP hourly cap on PATCH /auth/devices/me/push-token (fail-closed, like every IP cap).
PUSH_TOKEN_UPDATES_PER_IP_PER_HOUR=30

# ---- Model routing + cost guardrails ----
# Bare Gemini model ids (no provider prefix). The capable tier handles extraction.
DEFAULT_CHEAP_MODEL=gemini-2.5-flash-lite
DEFAULT_CAPABLE_MODEL=gemini-2.5-flash
# Per-profile cost guardrails (INR). Alert/target are flags only; the ceiling is
# a hard per-call cap — a real call whose worst-case cost exceeds it falls back to mock.
AI_COST_ALERT_PROFILE_INR=6
AI_TARGET_PROFILE_COST_INR=4
AI_MAX_CALL_COST_INR=10

# ---- Fallback provider: Anthropic / Claude (BACKEND ONLY) ----
# OPTIONAL. When set, Claude Haiku is added to the router's provider-fallback
# chain (Gemini primary -> Claude Haiku -> deterministic mock), used only when a
# real Gemini call fails. This key is NOT a master gate — GEMINI_FLASH_API_KEY +
# AI_ENABLE_REAL_CALLS still govern whether real calls happen at all. Placeholder
# only; treat as a secret. Reached via the official `anthropic` SDK.
ANTHROPIC_API_KEY=
# Fallback model id (no date suffix, per the Anthropic API).
DEFAULT_FALLBACK_MODEL=claude-haiku-4-5

# ---- Google Cloud (optional; Node-side declarations only) ----
# NOTE: the AI service no longer reads these — it calls Gemini directly via
# GEMINI_FLASH_API_KEY above. These remain only because packages/config/src/server.ts
# still declares them (all optional). Safe to leave blank.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_API_KEY=

# ---- Speech-to-text (Sarvam) ----
# Real STT requires AI_ENABLE_REAL_CALLS=true AND SARVAM_API_KEY (fails closed to
# an empty transcript otherwise — never fabricated). The AI service ALSO reads the
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above to fetch the uploaded voice audio
# (Storage Mode A, service-role) before transcribing. The Sarvam sync endpoint
# accepts clips UNDER 30s only; longer audio fails closed (batch STT is future work).
SARVAM_API_KEY=replace-with-sarvam-key
# Private bucket holding uploaded voice notes (object key = the request storage_path).
# MUST be created PRIVATE out-of-band — Storage object ACLs are not covered by RLS.
VOICE_NOTES_BUCKET=worker-voice-notes
# ADR-0032 — private bucket of worker profile photos (server-chosen opaque keys).
# EMPTY = DORMANT: the photo routes 503 fail-closed. Setting it arms the feature
# AND the account-deletion photo sweep together. MUST be created PRIVATE out-of-band.
WORKER_PHOTOS_BUCKET=
# Sarvam STT model id (config so the future saaras:v3 swap is one line).
SARVAM_STT_MODEL=saarika:v2.5
# Sarvam text-translation model — English output via /translate (mayura:v1 is the
# only model with auto-detect + code-mixed/Hinglish source support).
SARVAM_TRANSLATE_MODEL=mayura:v1

# --- text-to-speech (Sarvam bulbul) -------------------------------------------
# The voice form's spoken questions. Rendered OFFLINE by
# `python -m app.cli.tts_render`, never per request: pack copy is static reviewed
# content, so the audio is a build artifact. No FastAPI route reaches the adapter
# (asserted by a boot test), so no request body can become speech.
# Needs `tts_synthesis` in AI_REAL_CALL_TASKS — its OWN key, so TTS can be armed
# without arming STT. That is the point of doing the outbound-only leg first.
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_OUTPUT_CODEC=wav
# Rate card: bulbul:v2 Rs 15/10k chars, bulbul:v3 Rs 30/10k. ESTIMATE until the
# first invoice. Sarvam rounds UP per request, so MIN_BILLED_CHARS models the floor
# — calibrate both from the tts_smoke run against the Sarvam dashboard.
SARVAM_TTS_COST_INR_PER_10K_CHARS=15.0
SARVAM_TTS_MIN_BILLED_CHARS=500

# ---- Admin auth: the 4th principal (ADR-0025, BACKEND ONLY) ----
# Signs the admin session token via its OWN httpOnly-JWT mechanism (separate signing
# secret + Redis namespace + typ:"admin" audience pin, so a worker/payer token can NEVER
# satisfy AdminAuthGuard and vice-versa). REQUIRED outside development/test AND must NOT
# equal JWT_SECRET above (a shared secret would defeat principal separation) — both
# enforced fail-closed by assertAdminAuthConfig. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=replace-with-32+-byte-random-distinct-from-JWT_SECRET

# ---- Observability (Langfuse placeholders) ----
# Tracing is OFF unless both keys are set. Only pseudonymized text is ever traced.
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
# EU cloud is the default; US cloud is https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keeps a staging deployment's traces out of the production dashboards and
# evaluators. Defaults to "development" when unset — the safe way to be wrong.
LANGFUSE_TRACING_ENVIRONMENT=development

# ---- Chat profiling: the Redis transcript buffer ----
# The interview no longer writes to Postgres per turn. Every message buffers under
# `chat:transcript:<sessionId>` and the whole conversation flushes ONCE, in one
# transaction, when it completes.
#
# TTL is the blast radius, stated plainly: Redis is the ONLY home of an in-flight
# interview, so this is how long a worker may leave a half-finished chat and still come
# back to it. It RESETS on every turn, so it bounds idleness, never total length.
CHAT_TRANSCRIPT_TTL_SECONDS=86400
# How long a session may sit idle before the abandonment sweep closes it as `abandoned`
# and PRESERVES what the buffer still holds (transcript + settled pack answers).
#
# The only number that matters here is its DISTANCE BELOW the TTL above. The sweep's whole
# value is reaching a dead interview while its Redis buffer is still alive — the difference
# between saving the verbatim transcript and saving only the periodic conversation_state
# checkpoint. 6h against a 24h TTL leaves ~18h of cover. Raising it toward the TTL silently
# converts recoveries into permanent losses.
#
# NOTE: the sweep PRESERVES; it never mints a profile. No extraction runs for an abandoned
# interview — a partial answer set must not become a rankable candidate.
CHAT_ABANDON_AFTER_SECONDS=21600
# Sweep cadence in hours (fractional allowed, so staging can tick fast).
CHAT_ABANDON_SWEEP_INTERVAL_HOURS=1
# The hard turn cap, and the AUTHORITATIVE one — the ai-service has the same number in
# AI_PROFILING_MAX_TURNS but holds no per-session state, so it can only enforce what it
# is told. A model must never be able to extend its own interview.
CHAT_MAX_TURNS=30
# How many prior turns travel to the model each turn. Re-sending the transcript is
# O(n^2) input cost; the window makes it O(n*window). Keep BELOW CHAT_MAX_TURNS.
CHAT_HISTORY_WINDOW_TURNS=20

# TD67: the ONE service-level bearer for apps/api -> apps/ai-service routes. When set,
# every ai-service route except /health requires this exact value in the
# x-ai-internal-token header; unset (default) keeps today's internal-only open posture.
# Scoped to the api->ai-service direction — NOT INTERNAL_SERVICE_TOKEN and NOT
# SKILLS_INTERNAL_TOKEN above (which guards the reverse direction). Set BOTH sides
# together (staging service env, never a committed file). Treat as a secret.
# AI_INTERNAL_TOKEN=replace-with-a-strong-random-secret

# ---- Service URLs / ports ----
API_PORT=3001
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
WEB_PORT=3000

# ---- CORS (BACKEND ONLY) ----
# Comma-separated exact origins allowed to call the API cross-origin. IGNORED in
# development/test (CORS reflects the request origin so local dev keeps working
# without this). REQUIRED outside dev — an empty/unset value denies ALL
# cross-origin requests (fail closed, never a "*" wildcard). Set it in
# staging/prod to that environment's actual web origins.
#
# GAP-XC-06 (#920): as of the payer-web box deploy pipeline, this list must include
# payer-web's own box origin, or every browser call payer-web's client bundle makes
# directly to the API (as opposed to its Server Actions, which call the API
# server-to-server and are unaffected by CORS) is silently blocked. The v1 box has
# NO domain yet (owner decision — see docker-compose.staging.yml's `payer-web`
# service block) — the real value is an exact `http://<box-ip>:<PAYER_WEB_PORT>`
# origin, e.g. "https://ops.badabhai.in,http://203.0.113.10:3002", NOT a hostname
# this repo can commit. Set the REAL value as the `CORS_ALLOWED_ORIGINS` secret
# (already threaded through `.github/workflows/ci.yml`'s `deploy-lightsail`) —
# never hardcode it here or anywhere else in git.
# CORS_ALLOWED_ORIGINS=https://ops.badabhai.in,http://203.0.113.10:3002

# ---- Web (Next.js) PUBLIC config (NEXT_PUBLIC_* is shipped to the browser) ----
# Only non-secret values belong here.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ENVIRONMENT=development
# Supabase client (browser-safe) — the publishable/anon key, NOT the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_me
# Web (Next.js) SERVER-only secret (NOT NEXT_PUBLIC_*, never shipped to the browser):
# the ops console's applicants pages (ADR-0009) read API routes behind
# InternalServiceGuard, so the console process needs the SAME INTERNAL_SERVICE_TOKEN
# set above (line ~59) in its server environment. It is read only in Server Components
# (apps/web/src/lib/api.ts via process.env) — it is never inlined into the client
# bundle. Unset => those reads get 401 and the page shows its error state.
