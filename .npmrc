# pnpm settings for the BadaBhai monorepo.
# Strict peer deps off to keep the lean-team install resilient across the
# Nest/Next/Drizzle version matrix. Revisit before GA.
strict-peer-dependencies=false
auto-install-peers=true
# Keep dependency hoisting predictable for NestJS reflect-metadata.
shamefully-hoist=false
# Supply-chain cooling-off window: do not resolve a version published in the last 7
# days (#737).
#
# TWO KEYS, TWO CLIENTS, TWO UNITS — this is not duplication and they are not
# interchangeable:
#   minimum-release-age  pnpm's key, in MINUTES (10080 = 7 days).
#   min-release-age      npm's key, in DAYS (npm >= 11.10). pnpm does not read it and
#                        npm does not read pnpm's, so a repo that sets only one is
#                        unprotected the moment anyone runs the other client — which
#                        `npx`, a CI action, or a contributor's muscle memory all do.
#
# KEEP ALL THREE IN SYNC: these two and `minimumReleaseAge` in pnpm-workspace.yaml,
# which is pnpm's source of truth. Same window, three spellings; a mismatch means the
# protection silently depends on which tool ran.
minimum-release-age=10080
min-release-age=7
