# pnpm settings for the BadaBhai monorepo.
# Strict peer deps off to keep the lean-team install resilient across the
# Nest/Next/Drizzle version matrix. Revisit before GA.
strict-peer-dependencies=false
auto-install-peers=true
# Keep dependency hoisting predictable for NestJS reflect-metadata.
shamefully-hoist=false
# Supply-chain cooling-off window, 7 days in minutes (#737). KEEP IN SYNC with
# `minimumReleaseAge` in pnpm-workspace.yaml — that file is the source of truth for
# pnpm, and this line is the same policy expressed where a plain `npm`/`npx`
# invocation (or a tool that reads only .npmrc) will also honour it. Both must carry
# the same number; a mismatch means the protection depends on which client ran.
minimum-release-age=10080
